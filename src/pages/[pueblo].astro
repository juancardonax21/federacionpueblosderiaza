---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icono from "../components/Icono.astro";
import { getPueblo, getPueblos, getNoticiasDePueblo, getFotosDePueblo, getEventosDePueblo } from "../lib/supabase";

const { pueblo: slug } = Astro.params;
const pb = await getPueblo(slug);

if (!pb) {
  return Astro.redirect("/los-pueblos/");
}

// Texto descriptivo desde la colección Markdown (de momento sigue ahí)
const paginas = await getCollection("paginas");
const pagina = paginas.find((p) => p.slug === pb.slug);
let Content = null;
if (pagina) {
  const rendered = await pagina.render();
  Content = rendered.Content;
}

// Galería de fotos desde Supabase
const fotos = await getFotosDePueblo(pb.id);

// Noticias relacionadas
const relacionadas = (await getNoticiasDePueblo(pb.slug)).slice(0, 3);

// Eventos próximos del pueblo
const eventosPueblo = (await getEventosDePueblo(pb.slug)).slice(0, 3);

const fecha = (d) =>
  new Date(d).toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });

function fechaEvento(inicio, fin) {
  if (!fin || fin === inicio) return fecha(inicio);
  return `Del ${new Date(inicio).toLocaleDateString("es-ES", { day: "numeric", month: "long" })} al ${fecha(fin)}`;
}

// Siguiente pueblo (todos ordenados)
const todos = await getPueblos();
const idx = todos.findIndex((p) => p.slug === pb.slug);
const siguiente = todos[(idx + 1) % todos.length];
---

<Base title={`${pb.nombre} · Pueblos de Riaza`} description={`${pb.nombre}, en la Sierra de Ayllón. ${pb.piedra}.`}>
  <article class="pueblo">
    <header class="pb-hero">
      <div class="pb-hero__foto">
        <img src={pb.foto_url} alt={pb.nombre} />
      </div>
      <div class="pb-hero__txt contenedor-ancho">
        <a class="volver" href="/los-pueblos/">← Los Pueblos</a>
        <span class="pb-piedra"><span class="pb-punto" style={`--p:${pb.color}`}></span> {pb.piedra}</span>
        <h1>{pb.nombre}</h1>
      </div>
    </header>

    <div class="pb-cuerpo contenedor-ancho">
      <div class="pb-texto prosa">
        {Content ? <Content /> : <p>{pb.nombre} forma parte de la Federación de Pueblos de Riaza.</p>}
      </div>

      <aside class="pb-ficha">
        <h2 class="pb-ficha__tit">Ficha</h2>
        <dl>
          <div class="pb-dato">
            <dt><Icono nombre="piedra" size={18} /> Piedra</dt>
            <dd>{pb.piedra}</dd>
          </div>
          {pb.habitantes && (
            <div class="pb-dato"><dt><Icono nombre="casa" size={18} /> Habitantes</dt><dd>{pb.habitantes}</dd></div>
          )}
          {pb.patron && (
            <div class="pb-dato"><dt><Icono nombre="brujula" size={18} /> Patrón</dt><dd>{pb.patron}</dd></div>
          )}
          {pb.fiesta_fecha && (
            <div class="pb-dato"><dt><Icono nombre="brujula" size={18} /> Fiesta</dt><dd>{pb.fiesta_fecha}</dd></div>
          )}
        </dl>
        {pb.maps_url && (
          <a class="pb-maps" href={pb.maps_url} target="_blank" rel="noopener">
            <Icono nombre="brujula" size={18} /> Ver en el mapa
          </a>
        )}
        {(!pb.habitantes || !pb.patron) && (
          <p class="pb-pendiente">Ficha en ampliación.</p>
        )}
      </aside>
    </div>

    {fotos.length > 0 && (
      <section class="pb-galeria contenedor-ancho">
        <header>
          <p class="ojillo">El pueblo en imágenes</p>
          <h2>Galería</h2>
        </header>
        <div class="pb-tira">
          {fotos.map((f) => (
            <a class="pb-foto" href={`/images/${f.archivo}`} target="_blank" rel="noopener">
              <img src={`/images/${f.archivo}`} alt={`${pb.nombre} ${f.orden}`} loading="lazy" />
            </a>
          ))}
        </div>
      </section>
    )}

    {eventosPueblo.length > 0 && (
      <section class="pb-eventos contenedor-ancho">
        <header class="seccion-cab"><h2>Eventos en {pb.nombre}</h2><span class="linea"></span></header>
        <div class="rejilla">
          {eventosPueblo.map((e) => (
            <a class="tarjeta" href={`/eventos/${e.slug}/`}>
              {e.cartel_url ? (
                <div class="tarjeta__img tarjeta__img--cartel"><img src={e.cartel_url} alt={e.titulo} /></div>
              ) : (
                <div class="tarjeta__img tarjeta__img--vacia"><span>FPR</span></div>
              )}
              <time class="meta">{fechaEvento(e.fecha_inicio, e.fecha_fin)}</time>
              <h3 class="tarjeta__titulo">{e.titulo}</h3>
              {e.lugar && <p class="tarjeta__lugar">{e.lugar}</p>}
            </a>
          ))}
        </div>
      </section>
    )}

    {relacionadas.length > 0 && (
      <section class="pb-noticias contenedor-ancho">
        <header class="seccion-cab"><h2>Noticias de {pb.nombre}</h2><span class="linea"></span></header>
        <div class="rejilla">
          {relacionadas.map((n) => (
            <a class="tarjeta" href={`/noticias/${n.slug}/`}>
              {n.portada_url ? (
                <div class="tarjeta__img"><img src={n.portada_url} alt={n.titulo} /></div>
              ) : (
                <div class="tarjeta__img tarjeta__img--vacia"><span>FPR</span></div>
              )}
              <time class="meta">{fecha(n.fecha)}</time>
              <h3 class="tarjeta__titulo">{n.titulo}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="pb-siguiente contenedor-ancho">
      <a href={`/${siguiente.slug}/`}>
        <span class="meta">Siguiente pueblo</span>
        <span class="pb-siguiente__n">{siguiente.nombre} →</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .pb-hero { position: relative; }
  .pb-hero__foto { aspect-ratio: 16/7; overflow: hidden; }
  .pb-hero__foto img { width: 100%; height: 100%; object-fit: cover; }
  .pb-hero__foto::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,18,15,0.85), rgba(20,18,15,0.1) 60%); }
  .pb-hero__txt { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; padding-bottom: 2rem; color: var(--c-papel); z-index: 1; }
  .volver { color: color-mix(in srgb, var(--c-papel) 80%, transparent); font-size: 0.85rem; display: inline-block; margin-bottom: 1rem; }
  .volver:hover { color: var(--c-papel); }
  .pb-piedra { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-papel); margin-bottom: 0.4rem; }
  .pb-punto { width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--p); }
  .pb-hero__txt h1 { color: var(--c-papel); font-size: clamp(2.4rem, 6vw, 4.5rem); text-shadow: 0 2px 20px rgba(0,0,0,0.4); }
  .pb-cuerpo { display: grid; grid-template-columns: 1.6fr 1fr; gap: 3.5rem; padding-top: 3.5rem; align-items: start; }
  .pb-texto { font-size: 1.12rem; }
  .pb-texto :global(blockquote) { border-left: 2px solid var(--c-ocre); padding-left: 1.3rem; margin: 1.8rem 0; font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--c-tinta); }
  .pb-ficha { background: var(--c-crema); border-radius: 2px; padding: 1.8rem; position: sticky; top: 6rem; }
  .pb-ficha__tit { font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-tenue); margin-bottom: 1.2rem; }
  .pb-ficha dl { margin: 0; }
  .pb-dato { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--c-borde); }
  .pb-dato dt { color: var(--c-verde); font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem; }
  .pb-dato dt :global(.icono) { color: var(--c-verde); }
  .pb-dato dd { margin: 0; font-weight: 500; text-align: right; font-size: 0.92rem; }
  .pb-maps { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.4rem; background: var(--c-tinta); color: var(--c-papel); padding: 0.7rem 1.2rem; border-radius: 2px; font-size: 0.82rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .pb-maps:hover { background: var(--c-rojo); }
  .pb-maps :global(.icono) { color: var(--c-ocre); }
  .pb-pendiente { font-size: 0.8rem; color: var(--c-tenue); margin-top: 1rem; font-style: italic; }

  /* Galería deslizable */
  .pb-galeria { margin-top: 5rem; }
  .pb-galeria header { margin-bottom: 1.5rem; }
  .pb-galeria h2 { font-size: 1.8rem; margin-top: 0.3rem; }
  .ojillo { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-tenue); }
  .pb-tira {
    display: flex; gap: 1rem; overflow-x: auto; padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin; scrollbar-color: var(--c-borde) transparent;
  }
  .pb-tira::-webkit-scrollbar { height: 6px; }
  .pb-tira::-webkit-scrollbar-thumb { background: var(--c-borde); border-radius: 3px; }
  .pb-foto {
    flex: 0 0 auto; width: 22rem; aspect-ratio: 4/3;
    border-radius: 3px; overflow: hidden; scroll-snap-align: start;
    transition: transform 0.3s ease;
  }
  .pb-foto:hover { transform: scale(1.02); }
  .pb-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .pb-noticias { margin-top: 5rem; }
  .pb-eventos { margin-top: 5rem; }
  .pb-eventos .tarjeta__img--cartel { aspect-ratio: 3/4; }
  .pb-eventos .tarjeta__lugar { font-size: 0.88rem; color: var(--c-tinta-suave); margin-top: 0.2rem; }
  .seccion-cab { display: flex; align-items: baseline; gap: 1.5rem; margin-bottom: 2rem; }
  .seccion-cab h2 { font-size: 1.8rem; }
  .seccion-cab .linea { flex: 1; height: 1px; background: var(--c-borde); }
  .meta { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-tenue); display: block; }
  .rejilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem 2rem; }
  .tarjeta__img { overflow: hidden; border-radius: 2px; aspect-ratio: 3/2; margin-bottom: 1rem; }
  .tarjeta__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .tarjeta:hover .tarjeta__img img { transform: scale(1.04); }
  .tarjeta__img--vacia { background: var(--c-crema); display: flex; align-items: center; justify-content: center; }
  .tarjeta__img--vacia span { font-family: var(--serif); font-size: 1.5rem; color: var(--c-borde); letter-spacing: 0.1em; }
  .tarjeta__titulo { font-size: 1.2rem; margin: 0.4rem 0 0; transition: color 0.2s ease; }
  .tarjeta:hover .tarjeta__titulo { color: var(--c-rojo); }
  .pb-siguiente { margin-top: 5rem; padding-top: 2rem; padding-bottom: 4rem; border-top: 1px solid var(--c-borde); }
  .pb-siguiente__n { font-family: var(--serif); font-size: 1.6rem; transition: color 0.2s ease; display: block; margin-top: 0.3rem; }
  .pb-siguiente a:hover .pb-siguiente__n { color: var(--c-rojo); }
  @media (max-width: 860px) {
    .pb-cuerpo { grid-template-columns: 1fr; }
    .pb-ficha { position: static; }
    .rejilla { grid-template-columns: 1fr; }
    .pb-foto { width: 16rem; }
  }
</style>
