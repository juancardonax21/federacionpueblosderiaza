---
import Base from "../../../../layouts/Base.astro";
import FormularioEvento from "../../../../components/admin/FormularioEvento.astro";
import { createClient } from "@supabase/supabase-js";

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY
);

const { id } = Astro.params;
const { data: evento } = await supabase
  .from("eventos")
  .select("*")
  .eq("id", id)
  .maybeSingle();

if (!evento) {
  return Astro.redirect("/admin/eventos/");
}
---

<Base title={`Editar: ${evento.titulo} · Panel Federación`} description="Editar evento">
  <section class="admin-form-page contenedor-ancho">
    <nav class="adm-migas">
      <a href="/admin/">Panel</a>
      <span class="adm-migas-sep">›</span>
      <a href="/admin/eventos/">Eventos</a>
      <span class="adm-migas-sep">›</span>
      <span class="adm-migas-actual">Editar</span>
    </nav>

    <h1 class="admin-form-titulo">Editar evento</h1>
    <p class="admin-form-lede">Modifica los datos y guarda los cambios.</p>

    <FormularioEvento evento={evento} />
  </section>
</Base>

<style is:global>
  .admin-form-page { padding: 2rem 1.5rem 4rem; max-width: 78rem; }
  .admin-form-titulo { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 1.2rem 0 0.5rem; }
  .admin-form-lede { color: var(--c-tinta-suave); margin-bottom: 2rem; font-family: var(--serif); font-style: italic; }
</style>
