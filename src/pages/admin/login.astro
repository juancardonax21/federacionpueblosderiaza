---
import Base from "../../layouts/Base.astro";
---

<Base title="Iniciar sesión · Panel Federación" description="Panel de administración">
  <section class="login contenedor">
    <div class="login__caja">
      <h1>Panel de administración</h1>
      <p class="login__lede">
        Accede con tu cuenta de la Federación para gestionar noticias y eventos.
      </p>
      <button id="btn-google" class="login__boton" type="button">
        Iniciar sesión con Google
      </button>
      <p class="login__nota">
        Solo cuentas autorizadas de <strong>@federacionpueblosderiaza.org</strong>.
      </p>
      <p id="login-error" class="login__error" hidden></p>
    </div>
  </section>
</Base>

<script>
  import { createClient } from "@supabase/supabase-js";

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY
  );

  const btn = document.getElementById("btn-google");
  const err = document.getElementById("login-error");

  // Si el usuario ya está logueado, mándalo directamente al panel.
  supabase.auth.getSession().then(({ data }) => {
    if (data?.session) {
      window.location.href = "/admin/";
    }
  });

  btn?.addEventListener("click", async () => {
    btn.setAttribute("disabled", "true");
    btn.textContent = "Redirigiendo...";
    const { error } = await supabase.auth.signInWithOAuth({
      provider: "google",
      options: {
        redirectTo: window.location.origin + "/admin/",
      },
    });
    if (error) {
      err.textContent = "Error al iniciar sesión: " + error.message;
      err.hidden = false;
      btn.removeAttribute("disabled");
      btn.textContent = "Iniciar sesión con Google";
    }
  });
</script>

<style>
  .login { padding: 4rem 1.5rem; min-height: 60vh; display: flex; align-items: center; justify-content: center; }
  .login__caja { max-width: 26rem; text-align: center; }
  .login__caja h1 { font-size: 2rem; margin-bottom: 1rem; }
  .login__lede { color: var(--c-tinta-suave); margin-bottom: 2rem; }
  .login__boton { display: inline-block; padding: 0.9rem 2rem; font-size: 0.95rem; letter-spacing: 0.06em; background: var(--c-tinta); color: var(--c-papel); border: none; border-radius: 2px; cursor: pointer; transition: background 0.2s ease; }
  .login__boton:hover:not([disabled]) { background: var(--c-rojo); }
  .login__boton[disabled] { opacity: 0.6; cursor: wait; }
  .login__nota { margin-top: 1.5rem; font-size: 0.82rem; color: var(--c-tenue); }
  .login__error { margin-top: 1rem; color: var(--c-rojo); font-size: 0.9rem; }
</style>
