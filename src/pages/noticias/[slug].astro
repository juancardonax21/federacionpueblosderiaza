---
import Base from "../../layouts/Base.astro";
import { getNoticias, getNoticia } from "../../lib/supabase";
import { Calendar } from "@lucide/astro";
import { marked } from "marked";
const { slug } = Astro.params;
const noticia = await getNoticia(slug);
if (!noticia) {
  return Astro.redirect("/al-dia/");
}
const contenidoHtml = noticia.contenido ? marked.parse(noticia.contenido) : "";
const otras = (await getNoticias(4)).filter((n) => n.slug !== slug).slice(0, 3);
const fecha = (d) =>
  new Date(d).toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });

// URL pública de esta noticia (para compartir)
const urlNoticia = `https://federacionpueblosderiaza.org/noticias/${slug}/`;
const textoCompartir = `${noticia.titulo} · Federación de Pueblos de Riaza`;
const enc = encodeURIComponent;
---
<Base title={`${noticia.titulo} · Federación Pueblos de Riaza`} description={noticia.entradilla || noticia.titulo} image={noticia.portada_url}>
  <article class="noticia">
    <header class="noticia__cab contenedor">
      <a class="volver" href="/al-dia/">← Al día</a>
      <h1>{noticia.titulo}</h1>
      {noticia.entradilla && <p class="noticia__lead">{noticia.entradilla}</p>}
      <time class="noticia__fecha"><Calendar size={18} style="display: inline; margin-right: 0.5rem; vertical-align: middle;" /> {fecha(noticia.fecha)}</time>
    </header>

    {noticia.fotos && noticia.fotos.length > 0 && noticia.fotos.find((f) => f.es_principal) ? (
      <figure class="noticia__portada contenedor">
        <img src={noticia.fotos.find((f) => f.es_principal).url} alt={noticia.titulo} />
        {noticia.fotos.find((f) => f.es_principal).pie_foto && (
          <figcaption>{noticia.fotos.find((f) => f.es_principal).pie_foto}</figcaption>
        )}
      </figure>
    ) : noticia.portada_url ? (
      <figure class="noticia__portada contenedor">
        <img src={noticia.portada_url} alt={noticia.titulo} />
      </figure>
    ) : null}

    <div class="noticia__cuerpo contenedor prosa" set:html={contenidoHtml} />

    {noticia.fotos && noticia.fotos.filter((f) => !f.es_principal).length > 0 && (
      <section class="noticia__galeria contenedor-ancho">
        <h2>Galería</h2>
        <div class="galeria-grid">
          {noticia.fotos.filter((f) => !f.es_principal).map((foto) => (
            <figure class="galeria-item">
              <img src={foto.url} alt="Foto galería" />
              {foto.pie_foto && <figcaption>{foto.pie_foto}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}
    <div class="compartir contenedor">
      <span class="compartir__et">Compartir</span>
      <div class="compartir__botones">
        <a class="compartir__b" href={`https://wa.me/?text=${enc(textoCompartir + " " + urlNoticia)}`} target="_blank" rel="noopener" aria-label="Compartir en WhatsApp">WhatsApp</a>
        <a class="compartir__b" href={`https://t.me/share/url?url=${enc(urlNoticia)}&text=${enc(textoCompartir)}`} target="_blank" rel="noopener" aria-label="Compartir en Telegram">Telegram</a>
        <a class="compartir__b" href={`https://www.facebook.com/sharer/sharer.php?u=${enc(urlNoticia)}`} target="_blank" rel="noopener" aria-label="Compartir en Facebook">Facebook</a>
        <button class="compartir__b compartir__copiar" data-url={urlNoticia} type="button">Copiar enlace</button>
      </div>
    </div>
  </article>
  {otras.length > 0 && (
    <section class="mas-noticias contenedor-ancho">
      <header class="seccion-cab"><h2>Más noticias</h2><span class="linea"></span></header>
      <div class="rejilla">
        {otras.map((n) => (
          <a class="tarjeta" href={`/noticias/${n.slug}/`}>
            {n.portada_url ? (
              <div class="tarjeta__img"><img src={n.portada_url} alt={n.titulo} /></div>
            ) : (
              <div class="tarjeta__img tarjeta__img--vacia"><span>FPR</span></div>
            )}
            <time class="meta">{fecha(n.fecha)}</time>
            <h3 class="tarjeta__titulo">{n.titulo}</h3>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  const btn = document.querySelector(".compartir__copiar");
  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.url);
      const original = btn.textContent;
      btn.textContent = "¡Copiado!";
      btn.classList.add("compartir__copiar--ok");
      setTimeout(() => { btn.textContent = original; btn.classList.remove("compartir__copiar--ok"); }, 2000);
    } catch {
      btn.textContent = "Copia manual: " + btn.dataset.url;
    }
  });
</script>

<style>
  .noticia__cab { padding: 3rem 1.5rem 2rem; }
  .volver { color: var(--c-tinta-suave); font-size: 0.85rem; display: inline-block; margin-bottom: 1.5rem; }
  .volver:hover { color: var(--c-rojo); }
  .noticia__cab .meta { display: block; margin-bottom: 0.5rem; }
  .noticia__cab h1 { font-size: clamp(2rem, 5vw, 3.4rem); line-height: 0.95; margin: 1.2rem 0 0.4rem; }
  .noticia__entradilla { font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--c-tinta-suave); margin-top: 1.2rem; line-height: 1.5; }
  .noticia__cuerpo { font-size: 1.12rem; padding-bottom: 2rem; }
  .meta { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-tenue); }

  /* Compartir */
  .compartir { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; padding-bottom: 3rem; border-bottom: 1px solid var(--c-borde); margin-bottom: 1rem; }
  .compartir__et { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-tenue); }
  .compartir__botones { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .compartir__b {
    font-family: var(--sans); font-size: 0.82rem; color: var(--c-tinta-suave);
    background: var(--c-crema); border: 1px solid var(--c-borde);
    padding: 0.5rem 1rem; border-radius: 2px; cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .compartir__b:hover { background: var(--c-tinta); color: var(--c-papel); border-color: var(--c-tinta); }
  .compartir__copiar--ok { background: var(--c-verde); color: var(--c-papel); border-color: var(--c-verde); }

  .mas-noticias { margin-top: 4rem; padding-bottom: 3rem; }
  .seccion-cab { display: flex; align-items: baseline; gap: 1.5rem; margin-bottom: 2rem; }
  .seccion-cab h2 { font-size: 1.8rem; }
  .seccion-cab .linea { flex: 1; height: 1px; background: var(--c-borde); }
  .rejilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem 2rem; }
  .tarjeta__img { overflow: hidden; border-radius: 2px; aspect-ratio: 3/2; margin-bottom: 1rem; }
  .tarjeta__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .tarjeta:hover .tarjeta__img img { transform: scale(1.04); }
  .tarjeta__img--vacia { background: var(--c-crema); display: flex; align-items: center; justify-content: center; }
  .tarjeta__img--vacia span { font-family: var(--serif); font-size: 1.5rem; color: var(--c-borde); letter-spacing: 0.1em; }
  .tarjeta__titulo { font-size: 1.2rem; margin: 0.4rem 0 0; transition: color 0.2s ease; }
  .tarjeta:hover .tarjeta__titulo { color: var(--c-rojo); }
  .noticia__lead { font-size: 1.5rem; line-height: 1.25; font-style: italic; margin: 1rem 0 0rem; color: var(--c-tinta-suave); }
  .noticia__fecha { font-size: 0.9rem; color: var(--c-tenue); margin-bottom: 0; }
  .noticia__portada { margin: 0 auto 1rem; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; }
  .noticia__portada img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 2px; }
  .noticia__portada figcaption { font-size: 0.9rem; color: var(--c-tinta-suave); margin-top: 0.8rem; font-style: italic; }
  .noticia__galeria { margin: 3rem 0; padding-top: 2rem; border-top: 1px solid var(--c-borde); }
  .noticia__galeria h2 { font-size: 1.6rem; margin-bottom: 1.5rem; font-family: var(--serif); font-weight: 400; }
  .galeria-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.5rem; }
  .galeria-item { overflow: hidden; border-radius: 2px; }
  .galeria-item img { width: 100%; height: 100%; display: block; aspect-ratio: 3 / 4; object-fit: cover; }
  .galeria-item figcaption { font-size: 0.85rem; color: var(--c-tinta-suave); padding: 0.8rem; background: var(--c-crema); font-style: italic; }
</style>
