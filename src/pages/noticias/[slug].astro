---
import Base from "../../layouts/Base.astro";
import { getNoticias, getNoticia } from "../../lib/supabase";
import { Calendar, ArrowLeft } from "@lucide/astro";
import { marked } from "marked";
const { slug } = Astro.params;
const noticia = await getNoticia(slug);
if (!noticia) {
  return Astro.redirect("/al-dia/");
}
const contenidoHtml = noticia.contenido ? marked.parse(noticia.contenido) : "";
const otras = (await getNoticias(4)).filter((n) => n.slug !== slug).slice(0, 3);

// Fotos separadas: editoriales fluyen en el artículo; utilidad (cartel, QR, mapa) van aparte.
const fotos = noticia.fotos ?? [];
const editoriales = fotos
  .filter((f) => !f.es_principal && f.tipo === "editorial")
  .sort((a, b) => a.orden - b.orden);
const utilidad = fotos
  .filter((f) => f.tipo === "utilidad")
  .sort((a, b) => a.orden - b.orden);

// Vídeo principal (sustituye a la foto): convierte la URL de YouTube/Vimeo en URL incrustable.
function urlEmbed(u) {
  if (!u) return null;
  try {
    const url = new URL(u.trim());
    const host = url.hostname.replace(/^www\./, "");
    if (host === "youtu.be") return `https://www.youtube.com/embed/${url.pathname.slice(1)}`;
    if (host.endsWith("youtube.com")) {
      const id = url.searchParams.get("v") || url.pathname.split("/").filter(Boolean).pop();
      return id ? `https://www.youtube.com/embed/${id}` : null;
    }
    if (host.endsWith("vimeo.com")) {
      const id = url.pathname.split("/").filter(Boolean).pop();
      return id ? `https://player.vimeo.com/video/${id}` : null;
    }
  } catch { return null; }
  return null;
}
const videoEmbed = urlEmbed(noticia.video_url);

const fecha = (d) =>
  new Date(d).toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });

// URL pública de esta noticia (para compartir)
const urlNoticia = `https://federacionpueblosderiaza.org/noticias/${slug}/`;
const textoCompartir = `${noticia.titulo} · Federación de Pueblos de Riaza`;
const enc = encodeURIComponent;
---
<Base title={`${noticia.titulo} · Federación Pueblos de Riaza`} description={noticia.entradilla || noticia.titulo} image={noticia.portada_url}>
  <article class="noticia">
    <header class="noticia__cab contenedor">
      <a class="volver" href="/al-dia/"><ArrowLeft size={15} /> Al día</a>
      <h1>{noticia.titulo}</h1>
      {noticia.entradilla && <p class="noticia__lead">{noticia.entradilla}</p>}
      <time class="noticia__fecha"><Calendar size={18} style="display: inline; margin-right: 0.5rem; vertical-align: middle;" /> {fecha(noticia.fecha)}</time>
    </header>

    {videoEmbed ? (
      <figure class="noticia__portada noticia__portada--video contenedor">
        <div class="video-embed">
          <iframe src={videoEmbed} title={noticia.titulo} loading="lazy" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      </figure>
    ) : noticia.fotos && noticia.fotos.length > 0 && noticia.fotos.find((f) => f.es_principal) ? (
      <figure class="noticia__portada contenedor">
        <img src={noticia.fotos.find((f) => f.es_principal).url} alt={noticia.titulo} />
        {noticia.fotos.find((f) => f.es_principal).pie_foto && (
          <figcaption>{noticia.fotos.find((f) => f.es_principal).pie_foto}</figcaption>
        )}
      </figure>
    ) : noticia.portada_url ? (
      <figure class="noticia__portada contenedor">
        <img src={noticia.portada_url} alt={noticia.titulo} />
      </figure>
    ) : null}

    <div class="noticia__cuerpo contenedor prosa" set:html={contenidoHtml} />

    {editoriales.length > 0 && (
      <div class="galeria-just" data-galeria>
        {editoriales.map((foto, i) => (
          <figure class="gj-item" data-i={i}>
            <img src={foto.url} alt={foto.pie_foto ?? ""} loading="lazy" data-pie={foto.pie_foto ?? ""} />
            {foto.pie_foto && <figcaption class="gj-cap">{foto.pie_foto}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    {editoriales.length > 0 && (
      <div class="gj-lightbox" data-lightbox hidden aria-hidden="true">
        <button class="gj-lb-cerrar" data-lb-close type="button" aria-label="Cerrar galería">✕</button>
        {editoriales.length > 1 && (
          <button class="gj-lb-nav gj-lb-prev" data-lb-prev type="button" aria-label="Foto anterior">‹</button>
        )}
        <figure class="gj-lb-fig">
          <img data-lb-img src="" alt="" />
          <figcaption class="gj-lb-pie">
            <span class="gj-lb-num" data-lb-num></span>
            <span data-lb-cap></span>
          </figcaption>
        </figure>
        {editoriales.length > 1 && (
          <button class="gj-lb-nav gj-lb-next" data-lb-next type="button" aria-label="Foto siguiente">›</button>
        )}
      </div>
    )}

    {utilidad.length > 0 && (
      <aside class="info-practica contenedor">
        <div class="info-practica__imgs">
          {utilidad.map((foto) => (
            <figure>
              <img src={foto.url} alt={foto.pie_foto ?? ""} loading="lazy" />
              {foto.pie_foto && <figcaption>{foto.pie_foto}</figcaption>}
            </figure>
          ))}
        </div>
      </aside>
    )}
    <div class="compartir contenedor">
      <span class="compartir__et">Compartir</span>
      <div class="compartir__botones">
        <a class="compartir__b" href={`https://wa.me/?text=${enc(textoCompartir + " " + urlNoticia)}`} target="_blank" rel="noopener" aria-label="Compartir en WhatsApp">
          <svg class="compartir__ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.042zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.29.173-1.414z"/></svg>
          <span>WhatsApp</span>
        </a>
        <a class="compartir__b" href={`https://t.me/share/url?url=${enc(urlNoticia)}&text=${enc(textoCompartir)}`} target="_blank" rel="noopener" aria-label="Compartir en Telegram">
          <svg class="compartir__ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.48-1.302.47-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.015 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          <span>Telegram</span>
        </a>
        <a class="compartir__b" href={`https://www.facebook.com/sharer/sharer.php?u=${enc(urlNoticia)}`} target="_blank" rel="noopener" aria-label="Compartir en Facebook">
          <svg class="compartir__ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          <span>Facebook</span>
        </a>
        <button class="compartir__b compartir__copiar" data-url={urlNoticia} type="button">
          <svg class="compartir__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span>Copiar enlace</span>
        </button>
      </div>
    </div>
  </article>
  {otras.length > 0 && (
    <section class="mas-noticias contenedor-ancho">
      <header class="seccion-cab"><h2>Más noticias</h2><span class="linea"></span></header>
      <div class="rejilla">
        {otras.map((n) => (
          <a class="tarjeta" href={`/noticias/${n.slug}/`}>
            {n.portada_url ? (
              <div class="tarjeta__img"><img src={n.portada_url} alt={n.titulo} /></div>
            ) : (
              <div class="tarjeta__img tarjeta__img--vacia"><span>FPR</span></div>
            )}
            <time class="meta">{fecha(n.fecha)}</time>
            <h3 class="tarjeta__titulo">{n.titulo}</h3>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  const btn = document.querySelector(".compartir__copiar");
  const btnLabel = btn?.querySelector("span");
  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.url);
      const original = btnLabel.textContent;
      btnLabel.textContent = "¡Copiado!";
      btn.classList.add("compartir__copiar--ok");
      setTimeout(() => { btnLabel.textContent = original; btn.classList.remove("compartir__copiar--ok"); }, 2000);
    } catch {
      btnLabel.textContent = "Copia manual";
    }
  });
</script>

<script>
  // Galería justificada: reparte las fotos en filas alineadas respetando su proporción.
  const gal = document.querySelector("[data-galeria]");
  if (gal) {
    const items = Array.from(gal.querySelectorAll(".gj-item"));
    const imgs = items.map((it) => it.querySelector("img"));
    const GAP = 8;

    function ratioDe(img) {
      return img.naturalWidth && img.naturalHeight ? img.naturalWidth / img.naturalHeight : 1.5;
    }

    function maquetar() {
      const W = gal.clientWidth - (parseFloat(getComputedStyle(gal).paddingLeft) + parseFloat(getComputedStyle(gal).paddingRight));
      if (W <= 0) return;
      const alturaObjetivo = W < 640 ? 180 : 240;
      const filas = [];
      let fila = [], suma = 0;
      items.forEach((it, i) => {
        const r = ratioDe(imgs[i]);
        it._r = r;
        fila.push(it); suma += r;
        if (suma * alturaObjetivo + GAP * (fila.length - 1) >= W) { filas.push(fila); fila = []; suma = 0; }
      });
      if (fila.length) filas.push({ items: fila, ultima: true });
      filas.forEach((f) => {
        const arr = f.items || f;
        const ultima = !!f.ultima;
        const sumaR = arr.reduce((a, it) => a + it._r, 0);
        let h = (W - GAP * (arr.length - 1)) / sumaR;
        if (ultima && h > alturaObjetivo * 1.35) h = alturaObjetivo;
        arr.forEach((it) => {
          it.style.flex = "0 0 auto";
          it.style.width = Math.floor(h * it._r) + "px";
          it.style.height = Math.round(h) + "px";
        });
      });
    }

    let cargadas = 0;
    imgs.forEach((img) => {
      if (img.complete) { if (++cargadas === imgs.length) maquetar(); }
      else img.addEventListener("load", () => { maquetar(); });
    });
    maquetar();
    let t;
    window.addEventListener("resize", () => { clearTimeout(t); t = setTimeout(maquetar, 150); });

    // Lightbox (visor)
    const lb = document.querySelector("[data-lightbox]");
    if (lb) {
      const lbImg = lb.querySelector("[data-lb-img]");
      const lbCap = lb.querySelector("[data-lb-cap]");
      const lbNum = lb.querySelector("[data-lb-num]");
      const total = imgs.length;
      let actual = 0;

      const pad2 = (n) => String(n).padStart(2, "0");
      function mostrar(i) {
        actual = (i + total) % total;
        const img = imgs[actual];
        lbImg.src = img.currentSrc || img.src;
        lbImg.alt = img.alt || "";
        const pie = img.dataset.pie || "";
        lbCap.textContent = pie;
        lbNum.textContent = total > 1 ? pad2(actual + 1) + " / " + pad2(total) : "";
        lb.hidden = false;
        lb.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }
      function cerrar() {
        lb.hidden = true;
        lb.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }

      items.forEach((it, i) => it.addEventListener("click", () => mostrar(i)));
      lb.querySelector("[data-lb-close]").addEventListener("click", cerrar);
      lb.querySelector("[data-lb-prev]")?.addEventListener("click", (e) => { e.stopPropagation(); mostrar(actual - 1); });
      lb.querySelector("[data-lb-next]")?.addEventListener("click", (e) => { e.stopPropagation(); mostrar(actual + 1); });
      lb.addEventListener("click", (e) => { if (e.target === lb || e.target === lb.querySelector(".gj-lb-fig")) cerrar(); });
      document.addEventListener("keydown", (e) => {
        if (lb.hidden) return;
        if (e.key === "Escape") cerrar();
        else if (e.key === "ArrowLeft") mostrar(actual - 1);
        else if (e.key === "ArrowRight") mostrar(actual + 1);
      });
    }
  }
</script>

<style>
  .noticia__cab { padding: 3rem 1.5rem 2rem; }
  .volver { color: var(--c-tinta-suave); font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 1.5rem; }
  .volver:hover { color: var(--c-rojo); }
  .noticia__cab .meta { display: block; margin-bottom: 0.5rem; }
  .noticia__cab h1 { font-size: clamp(2rem, 5vw, 3.4rem); line-height: 0.95; margin: 1.2rem 0 0.4rem; }
  .noticia__entradilla { font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--c-tinta-suave); margin-top: 1.2rem; line-height: 1.5; }
  .noticia__cuerpo { font-size: 1.12rem; padding-bottom: 2rem; }
  .meta { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-tenue); }

  /* Compartir */
  .compartir { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; padding-bottom: 3rem; border-bottom: 1px solid var(--c-borde); margin-bottom: 1rem; }
  .compartir__et { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-tenue); }
  .compartir__botones { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .compartir__b {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--sans); font-size: 0.82rem; color: var(--c-tinta-suave);
    background: var(--c-crema); border: 1px solid var(--c-borde);
    padding: 0.5rem 0.95rem; border-radius: 2px; cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .compartir__b:hover { background: var(--c-tinta); color: var(--c-papel); border-color: var(--c-tinta); }
  .compartir__ico { width: 15px; height: 15px; flex-shrink: 0; display: block; }
  .compartir__copiar--ok { background: var(--c-verde); color: var(--c-papel); border-color: var(--c-verde); }

  .mas-noticias { margin-top: 4rem; padding-bottom: 3rem; }
  .seccion-cab { display: flex; align-items: baseline; gap: 1.5rem; margin-bottom: 2rem; }
  .seccion-cab h2 { font-size: 1.8rem; }
  .seccion-cab .linea { flex: 1; height: 1px; background: var(--c-borde); }
  .rejilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem 2rem; }
  .tarjeta__img { overflow: hidden; border-radius: 3px; border: 1px solid var(--c-borde); aspect-ratio: 3/2; margin-bottom: 1rem; }
  .tarjeta__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .tarjeta:hover .tarjeta__img img { transform: scale(1.04); }
  .tarjeta__img--vacia { background: var(--c-crema); display: flex; align-items: center; justify-content: center; }
  .tarjeta__img--vacia span { font-family: var(--serif); font-size: 1.5rem; color: var(--c-borde); letter-spacing: 0.1em; }
  .tarjeta__titulo { font-size: 1.2rem; margin: 0.4rem 0 0; transition: color 0.2s ease; }
  .tarjeta:hover .tarjeta__titulo { color: var(--c-rojo); }
  .noticia__lead { font-size: 1.5rem; line-height: 1.25; font-style: italic; margin: 1rem 0 0rem; color: var(--c-tinta-suave); }
  .noticia__fecha { font-size: 0.9rem; color: var(--c-tenue); margin-bottom: 0; }
  .noticia__portada { margin: 0 auto 1rem; width: 100%; }
  .noticia__portada img { width: 100%; height: auto; object-fit: cover; display: block; border-radius: 2px; aspect-ratio: 16 / 9; }
  .noticia__portada figcaption { font-size: 0.9rem; color: var(--c-tinta-suave); margin-top: 0.8rem; font-style: italic; }
  .video-embed { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 2px; overflow: hidden; background: #000; }
  .video-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  /* Galería justificada: filas alineadas que respetan la proporción de cada foto (el script fija width/height). */
  .galeria-just { display: flex; flex-wrap: wrap; gap: 8px; max-width: 64rem; margin: 1rem auto 3rem; padding-inline: clamp(1.5rem, 5vw, 4rem); align-content: flex-start; }
  .gj-item { position: relative; margin: 0; overflow: hidden; border-radius: 2px; cursor: zoom-in; background: var(--c-crema); flex: 1 1 14rem; }
  .gj-item img { width: 100%; height: auto; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .gj-item:hover img { transform: scale(1.04); }
  .gj-cap {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 1.4rem 0.9rem 0.6rem;
    font-family: var(--serif); font-style: italic; font-size: 0.85rem; color: #fff; line-height: 1.3;
    background: linear-gradient(to top, rgba(0,0,0,0.62), rgba(0,0,0,0));
    opacity: 0; transform: translateY(0.4rem); transition: opacity 0.3s ease, transform 0.3s ease; pointer-events: none;
  }
  .gj-item:hover .gj-cap { opacity: 1; transform: translateY(0); }

  /* Lightbox (visor) editorial */
  .gj-lightbox { position: fixed; inset: 0; z-index: 1000; background: rgba(16, 14, 10, 0.985); display: flex; align-items: center; justify-content: center; padding: clamp(1rem, 5vw, 4rem); }
  .gj-lightbox[hidden] { display: none; }
  .gj-lb-fig { margin: 0; max-width: 100%; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .gj-lb-fig img { max-width: 100%; max-height: 80vh; object-fit: contain; border-radius: 2px; }
  .gj-lb-pie { font-family: var(--serif); font-style: italic; font-size: 0.95rem; color: rgba(250,248,243,0.85); text-align: center; max-width: 42rem; }
  .gj-lb-num { display: inline-block; margin-right: 0.7rem; font-style: normal; letter-spacing: 0.12em; font-size: 0.78rem; color: var(--c-ocre); }
  .gj-lb-cerrar { position: absolute; top: 1.2rem; right: 1.5rem; background: none; border: none; color: var(--c-papel); font-size: 1.7rem; line-height: 1; cursor: pointer; opacity: 0.8; transition: opacity 0.2s ease; }
  .gj-lb-cerrar:hover { opacity: 1; }
  .gj-lb-nav { position: absolute; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--c-papel); font-size: 3rem; line-height: 1; cursor: pointer; padding: 0 1rem; opacity: 0.55; transition: opacity 0.2s ease; font-family: var(--serif); }
  .gj-lb-nav:hover { opacity: 1; }
  .gj-lb-prev { left: 0.5rem; }
  .gj-lb-next { right: 0.5rem; }
  @media (max-width: 640px) {
    .gj-lb-nav { font-size: 2.2rem; }
    .noticia__cab h1 { font-size: 2.5rem; }
    .noticia__lead { font-size: 1.2rem; line-height: 1.3; }
    .rejilla { grid-template-columns: 1fr; }
  }

  .info-practica {
    border: 1px solid var(--c-borde); border-radius: 10px;
    background: #fffefb; padding: 1.25rem 1.5rem; margin: 2.5rem auto;
  }
  .info-practica__imgs { display: flex; gap: 1.25rem; align-items: flex-start; flex-wrap: wrap; }
  .info-practica__imgs figure { margin: 0; max-width: 160px; }
  .info-practica__imgs img { max-height: 150px; width: auto; border-radius: 4px; display: block; }
  .info-practica__imgs figcaption { font-size: 0.8rem; color: var(--c-tenue); margin-top: 0.35rem; }
</style>
