---
import Base from "../../layouts/Base.astro";
import { getEvento, getEventos } from "../../lib/supabase";
import { marked } from "marked";

const { slug } = Astro.params;
const evento = await getEvento(slug);

if (!evento) {
  return Astro.redirect("/al-dia/eventos/");
}

const descripcionHtml = evento.descripcion ? marked.parse(evento.descripcion) : "";

// URL pública para compartir
const urlEvento = `https://federacionpueblosderiaza.org/eventos/${slug}/`;
const textoCompartir = `${evento.titulo} · Federación de Pueblos de Riaza`;
const enc = encodeURIComponent;

// Formato de fecha amigable
function formatearFecha(inicio, fin) {
  const opts = { day: "numeric", month: "long", year: "numeric" };
  if (!fin || fin === inicio) {
    return new Date(inicio).toLocaleDateString("es-ES", opts);
  }
  const i = new Date(inicio).toLocaleDateString("es-ES", { day: "numeric", month: "long" });
  const f = new Date(fin).toLocaleDateString("es-ES", opts);
  return `Del ${i} al ${f}`;
}

// Otros eventos próximos
const otros = (await getEventos()).filter((e) => e.slug !== slug).slice(0, 3);
---

<Base title={`${evento.titulo} · Federación Pueblos de Riaza`} description={evento.descripcion || evento.titulo} image={evento.cartel_url}>
  <article class="evento">
    <header class="evento__cab contenedor">
      <a class="volver" href="/al-dia/eventos/">← Agenda</a>
    </header>

    <div class="evento__principal contenedor-ancho">
      {evento.cartel_url && (
        <figure class="evento__cartel">
          <button class="evento__cartel-boton" type="button" data-src={evento.cartel_url} data-alt={`Cartel de ${evento.titulo}`} aria-label="Ampliar cartel">
            <img src={evento.cartel_url} alt={`Cartel de ${evento.titulo}`} />
          </button>
        </figure>
      )}
      <div class="evento__info">
        <p class="ojillo ojillo--rojo">Evento</p>
        <h1>{evento.titulo}</h1>

        <dl class="evento__datos">
          <div class="evento__dato">
            <dt>Fecha</dt>
            <dd>{formatearFecha(evento.fecha_inicio, evento.fecha_fin)}</dd>
          </div>
          {evento.hora && (
            <div class="evento__dato"><dt>Hora</dt><dd>{evento.hora}</dd></div>
          )}
          {evento.lugar && (
            <div class="evento__dato"><dt>Lugar</dt><dd>{evento.lugar}</dd></div>
          )}
          {evento.precio && (
            <div class="evento__dato"><dt>Precio</dt><dd>{evento.precio}</dd></div>
          )}
        </dl>

        <div class="evento__acciones">
          {evento.url_inscripcion && (
            <a class="boton boton--principal" href={evento.url_inscripcion} target="_blank" rel="noopener">Inscribirse →</a>
          )}
          {evento.url_info && (
            <a class="boton boton--linea" href={evento.url_info} target="_blank" rel="noopener">Más información</a>
          )}
        </div>

        {descripcionHtml && (
          <div class="evento__cuerpo prosa" set:html={descripcionHtml} />
        )}
      </div>
    </div>

    <div class="compartir contenedor">
      <span class="compartir__et">Compartir</span>
      <div class="compartir__botones">
        <a class="compartir__b" href={`https://wa.me/?text=${enc(textoCompartir + " " + urlEvento)}`} target="_blank" rel="noopener" aria-label="Compartir en WhatsApp">WhatsApp</a>
        <a class="compartir__b" href={`https://t.me/share/url?url=${enc(urlEvento)}&text=${enc(textoCompartir)}`} target="_blank" rel="noopener" aria-label="Compartir en Telegram">Telegram</a>
        <a class="compartir__b" href={`https://www.facebook.com/sharer/sharer.php?u=${enc(urlEvento)}`} target="_blank" rel="noopener" aria-label="Compartir en Facebook">Facebook</a>
        <button class="compartir__b compartir__copiar" data-url={urlEvento} type="button">Copiar enlace</button>
      </div>
    </div>
  </article>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox__cerrar" id="lightbox-cerrar" aria-label="Cerrar">×</button>
    <img id="lightbox-img" src="" alt="" />
  </div>

  {otros.length > 0 && (
    <section class="mas contenedor-ancho">
      <header class="seccion-cab"><h2>Más eventos próximos</h2><span class="linea"></span></header>
      <div class="rejilla">
        {otros.map((e) => (
          <a class="tarjeta" href={`/eventos/${e.slug}/`}>
            {e.cartel_url ? (
              <div class="tarjeta__img"><img src={e.cartel_url} alt={e.titulo} /></div>
            ) : (
              <div class="tarjeta__img tarjeta__img--vacia"><span>FPR</span></div>
            )}
            <time class="meta">{formatearFecha(e.fecha_inicio, e.fecha_fin)}</time>
            <h3 class="tarjeta__titulo">{e.titulo}</h3>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  // Compartir: copiar enlace
  const btn = document.querySelector(".compartir__copiar");
  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.url);
      const original = btn.textContent;
      btn.textContent = "¡Copiado!";
      btn.classList.add("compartir__copiar--ok");
      setTimeout(() => { btn.textContent = original; btn.classList.remove("compartir__copiar--ok"); }, 2000);
    } catch {
      btn.textContent = "Copia manual: " + btn.dataset.url;
    }
  });

  // Lightbox del cartel
  const cartelBtn = document.querySelector(".evento__cartel-boton");
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const lightboxCerrar = document.getElementById("lightbox-cerrar");

  function abrirLightbox() {
    lightboxImg.src = cartelBtn.dataset.src;
    lightboxImg.alt = cartelBtn.dataset.alt;
    lightbox.classList.add("lightbox--abierto");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }
  function cerrarLightbox() {
    lightbox.classList.remove("lightbox--abierto");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  cartelBtn?.addEventListener("click", abrirLightbox);
  lightboxCerrar?.addEventListener("click", cerrarLightbox);
  // Cerrar al hacer clic fuera de la imagen
  lightbox?.addEventListener("click", (e) => { if (e.target === lightbox) cerrarLightbox(); });
  // Cerrar con Escape
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") cerrarLightbox(); });
</script>

<style>
  .evento__cab { padding: 3rem 1.5rem 1.5rem; }
  .volver { color: var(--c-tinta-suave); font-size: 0.85rem; }
  .volver:hover { color: var(--c-rojo); }
  .evento__principal { display: grid; grid-template-columns: minmax(0, auto) minmax(0, 1fr); gap: 3rem; padding-top: 1rem; align-items: start; }
  .evento__cartel { margin: 0; width: 260px; max-width: 100%; }
  .evento__cartel-boton {
    width: 100%; padding: 0; border: none; background: none; cursor: zoom-in;
    display: block; transition: transform 0.3s ease;
  }
  .evento__cartel-boton:hover { transform: scale(1.02); }
  .evento__cartel img { width: 100%; height: auto; border-radius: 2px; display: block; box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
  .evento__info h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0.4rem 0 1.6rem; }
  .ojillo--rojo { color: var(--c-rojo); }
  .evento__datos { margin: 0 0 1.5rem; padding: 1.5rem 0; border-top: 1px solid var(--c-borde); border-bottom: 1px solid var(--c-borde); }
  .evento__dato { display: grid; grid-template-columns: 6rem 1fr; gap: 1rem; padding: 0.5rem 0; }
  .evento__dato dt { color: var(--c-tenue); font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .evento__dato dd { margin: 0; font-size: 1.02rem; }
  .evento__acciones { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .boton { display: inline-block; padding: 0.85rem 1.6rem; font-size: 0.85rem; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 2px; transition: background 0.2s ease, color 0.2s ease; }
  .boton--principal { background: var(--c-rojo); color: var(--c-papel); }
  .boton--principal:hover { background: var(--c-rojo-hondo); }
  .boton--linea { background: transparent; color: var(--c-tinta); border: 1px solid var(--c-tinta); }
  .boton--linea:hover { background: var(--c-tinta); color: var(--c-papel); }

  .evento__cuerpo { padding: 0.5rem 0 2rem; font-size: 1.02rem; }

  /* Compartir */
  .compartir { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; padding-bottom: 3rem; border-bottom: 1px solid var(--c-borde); margin-bottom: 1rem; }
  .compartir__et { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-tenue); }
  .compartir__botones { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .compartir__b { font-family: var(--sans); font-size: 0.82rem; color: var(--c-tinta-suave); background: var(--c-crema); border: 1px solid var(--c-borde); padding: 0.5rem 1rem; border-radius: 2px; cursor: pointer; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease; }
  .compartir__b:hover { background: var(--c-tinta); color: var(--c-papel); border-color: var(--c-tinta); }
  .compartir__copiar--ok { background: var(--c-verde); color: var(--c-papel); border-color: var(--c-verde); }

  .mas { margin-top: 4rem; padding-bottom: 3rem; }
  .seccion-cab { display: flex; align-items: baseline; gap: 1.5rem; margin-bottom: 2rem; }
  .seccion-cab h2 { font-size: 1.8rem; }
  .seccion-cab .linea { flex: 1; height: 1px; background: var(--c-borde); }
  .meta { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-tenue); display: block; }
  .rejilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem 2rem; }
  .tarjeta__img { overflow: hidden; border-radius: 2px; aspect-ratio: 3/4; margin-bottom: 1rem; background: var(--c-crema); }
  .tarjeta__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .tarjeta:hover .tarjeta__img img { transform: scale(1.04); }
  .tarjeta__img--vacia { display: flex; align-items: center; justify-content: center; }
  .tarjeta__img--vacia span { font-family: var(--serif); font-size: 1.5rem; color: var(--c-borde); letter-spacing: 0.1em; }
  .tarjeta__titulo { font-size: 1.2rem; margin: 0.4rem 0 0; transition: color 0.2s ease; }
  .tarjeta:hover .tarjeta__titulo { color: var(--c-rojo); }

  /* Lightbox del cartel */
  .lightbox {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(20, 18, 15, 0.92);
    display: flex; align-items: center; justify-content: center;
    padding: 2rem;
    opacity: 0; visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    cursor: zoom-out;
  }
  .lightbox--abierto { opacity: 1; visibility: visible; }
  .lightbox img { max-width: 100%; max-height: 100%; height: auto; width: auto; display: block; box-shadow: 0 8px 32px rgba(0,0,0,0.5); }
  .lightbox__cerrar {
    position: absolute; top: 1rem; right: 1.5rem;
    width: 2.5rem; height: 2.5rem; background: none; border: none;
    color: var(--c-papel); font-size: 2rem; line-height: 1; cursor: pointer;
    font-family: var(--sans);
  }
  .lightbox__cerrar:hover { color: var(--c-ocre); }

  @media (max-width: 860px) {
    .evento__principal { grid-template-columns: 1fr; }
    .rejilla { grid-template-columns: 1fr; }
  }
</style>
