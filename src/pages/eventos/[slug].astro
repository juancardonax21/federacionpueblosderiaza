---
import Base from "../../layouts/Base.astro";
import { getEvento, getEventos } from "../../lib/supabase";
import { marked } from "marked";
import { CalendarDays, Clock, MapPin, Ticket, ArrowUpRight, ArrowLeft } from "@lucide/astro";

const { slug } = Astro.params;
const evento = await getEvento(slug);

if (!evento) {
  return Astro.redirect("/al-dia/");
}

const descripcionHtml = evento.descripcion ? marked.parse(evento.descripcion) : "";

// URL pública para compartir
const urlEvento = `https://federacionpueblosderiaza.org/eventos/${slug}/`;
const textoCompartir = `${evento.titulo} · Federación de Pueblos de Riaza`;
const enc = encodeURIComponent;

// Formato de fecha amigable
function formatearFecha(inicio, fin) {
  const opts = { day: "numeric", month: "long", year: "numeric" };
  if (!fin || fin === inicio) {
    return new Date(inicio).toLocaleDateString("es-ES", opts);
  }
  const i = new Date(inicio).toLocaleDateString("es-ES", { day: "numeric", month: "long" });
  const f = new Date(fin).toLocaleDateString("es-ES", opts);
  return `Del ${i} al ${f}`;
}

// Otros eventos próximos
const otros = (await getEventos()).filter((e) => e.slug !== slug).slice(0, 3);
---

<Base title={`${evento.titulo} · Federación Pueblos de Riaza`} description={evento.descripcion || evento.titulo} image={evento.cartel_url}>
  <article class="evento">
    <header class="evento__cab contenedor">
      <a class="volver" href="/al-dia/"><ArrowLeft size={15} /> Al día</a>
    </header>

    <div class="evento__principal contenedor-ancho">
      {evento.cartel_url && (
        <figure class="evento__cartel">
          <button class="evento__cartel-boton" type="button" data-src={evento.cartel_url} data-alt={`Cartel de ${evento.titulo}`} aria-label="Ampliar cartel">
            <img src={evento.cartel_url} alt={`Cartel de ${evento.titulo}`} />
          </button>
        </figure>
      )}
      <div class="evento__info">
        <p class="ojillo ojillo--rojo">Evento</p>
        <h1>{evento.titulo}</h1>

        <dl class="evento__datos">
          <div class="evento__dato">
            <span class="evento__dato-ico"><CalendarDays size={19} /></span>
            <div class="evento__dato-txt"><dt>Fecha</dt><dd>{formatearFecha(evento.fecha_inicio, evento.fecha_fin)}</dd></div>
          </div>
          {evento.hora && (
            <div class="evento__dato">
              <span class="evento__dato-ico"><Clock size={19} /></span>
              <div class="evento__dato-txt"><dt>Hora</dt><dd>{evento.hora}</dd></div>
            </div>
          )}
          {evento.lugar && (
            <div class="evento__dato">
              <span class="evento__dato-ico"><MapPin size={19} /></span>
              <div class="evento__dato-txt"><dt>Lugar</dt><dd>{evento.lugar}</dd></div>
            </div>
          )}
          {evento.precio && (
            <div class="evento__dato">
              <span class="evento__dato-ico"><Ticket size={19} /></span>
              <div class="evento__dato-txt"><dt>Precio</dt><dd>{evento.precio}</dd></div>
            </div>
          )}
        </dl>

        <div class="evento__acciones">
          {evento.url_inscripcion && (
            <a class="boton boton--principal" href={evento.url_inscripcion} target="_blank" rel="noopener">Inscribirse <ArrowUpRight size={16} /></a>
          )}
          {evento.url_info && (
            <a class="boton boton--linea" href={evento.url_info} target="_blank" rel="noopener">Más información <ArrowUpRight size={16} /></a>
          )}
        </div>

        {descripcionHtml && (
          <div class="evento__cuerpo prosa" set:html={descripcionHtml} />
        )}
      </div>
    </div>

    <div class="compartir contenedor">
      <span class="compartir__et">Compartir</span>
      <div class="compartir__botones">
        <a class="compartir__b" href={`https://wa.me/?text=${enc(textoCompartir + " " + urlEvento)}`} target="_blank" rel="noopener" aria-label="Compartir en WhatsApp">
          <svg class="compartir__ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.042zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.29.173-1.414z"/></svg>
          <span>WhatsApp</span>
        </a>
        <a class="compartir__b" href={`https://t.me/share/url?url=${enc(urlEvento)}&text=${enc(textoCompartir)}`} target="_blank" rel="noopener" aria-label="Compartir en Telegram">
          <svg class="compartir__ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.48-1.302.47-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.015 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          <span>Telegram</span>
        </a>
        <a class="compartir__b" href={`https://www.facebook.com/sharer/sharer.php?u=${enc(urlEvento)}`} target="_blank" rel="noopener" aria-label="Compartir en Facebook">
          <svg class="compartir__ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          <span>Facebook</span>
        </a>
        <button class="compartir__b compartir__copiar" data-url={urlEvento} type="button">
          <svg class="compartir__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span>Copiar enlace</span>
        </button>
      </div>
    </div>
  </article>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox__cerrar" id="lightbox-cerrar" aria-label="Cerrar">×</button>
    <img id="lightbox-img" src="" alt="" />
  </div>

  {otros.length > 0 && (
    <section class="mas contenedor-ancho">
      <header class="seccion-cab"><h2>Más eventos próximos</h2><span class="linea"></span></header>
      <div class="rejilla">
        {otros.map((e) => (
          <a class="tarjeta" href={`/eventos/${e.slug}/`}>
            {e.cartel_url ? (
              <div class="tarjeta__img"><img src={e.cartel_url} alt={e.titulo} /></div>
            ) : (
              <div class="tarjeta__img tarjeta__img--vacia"><span>FPR</span></div>
            )}
            <time class="meta">{formatearFecha(e.fecha_inicio, e.fecha_fin)}</time>
            <h3 class="tarjeta__titulo">{e.titulo}</h3>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  // Compartir: copiar enlace
  const btn = document.querySelector(".compartir__copiar");
  const btnLabel = btn?.querySelector("span");
  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.url);
      const original = btnLabel.textContent;
      btnLabel.textContent = "¡Copiado!";
      btn.classList.add("compartir__copiar--ok");
      setTimeout(() => { btnLabel.textContent = original; btn.classList.remove("compartir__copiar--ok"); }, 2000);
    } catch {
      btnLabel.textContent = "Copia manual";
    }
  });

  // Lightbox del cartel
  const cartelBtn = document.querySelector(".evento__cartel-boton");
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const lightboxCerrar = document.getElementById("lightbox-cerrar");

  function abrirLightbox() {
    lightboxImg.src = cartelBtn.dataset.src;
    lightboxImg.alt = cartelBtn.dataset.alt;
    lightbox.classList.add("lightbox--abierto");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }
  function cerrarLightbox() {
    lightbox.classList.remove("lightbox--abierto");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  cartelBtn?.addEventListener("click", abrirLightbox);
  lightboxCerrar?.addEventListener("click", cerrarLightbox);
  // Cerrar al hacer clic fuera de la imagen
  lightbox?.addEventListener("click", (e) => { if (e.target === lightbox) cerrarLightbox(); });
  // Cerrar con Escape
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") cerrarLightbox(); });
</script>

<style>
  .evento__cab { padding: 3rem 1.5rem 1.5rem; }
  .volver { color: var(--c-tinta-suave); font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.35rem; }
  .volver:hover { color: var(--c-rojo); }
  .evento__principal { display: grid; grid-template-columns: minmax(0, auto) minmax(0, 1fr); gap: 3rem; padding-top: 1rem; align-items: start; }
  .evento__cartel { margin: 0; width: 260px; max-width: 100%; }
  .evento__cartel-boton {
    width: 100%; padding: 0; border: none; background: none; cursor: zoom-in;
    display: block; transition: transform 0.3s ease;
  }
  .evento__cartel-boton:hover { transform: scale(1.02); }
  .evento__cartel img { width: 100%; height: auto; border-radius: 2px; display: block; box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
  .evento__info h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0.4rem 0 1.6rem; }
  .ojillo--rojo { color: var(--c-rojo); }
  .evento__datos { margin: 0 0 1.5rem; padding: 1.5rem 0; border-top: 1px solid var(--c-borde); border-bottom: 1px solid var(--c-borde); }
  .evento__dato { display: flex; align-items: flex-start; gap: 0.9rem; padding: 0.55rem 0; }
  .evento__dato-ico { color: var(--c-rojo); flex-shrink: 0; margin-top: 0.15rem; display: inline-flex; }
  .evento__dato-txt dt { color: var(--c-tenue); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.1rem; }
  .evento__dato-txt dd { margin: 0; font-size: 1.02rem; }
  .evento__acciones { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .boton { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.6rem; font-size: 0.85rem; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 2px; transition: background 0.2s ease, color 0.2s ease; }
  .boton--principal { background: var(--c-rojo); color: var(--c-papel); }
  .boton--principal:hover { background: var(--c-rojo-hondo); }
  .boton--linea { background: transparent; color: var(--c-tinta); border: 1px solid var(--c-tinta); }
  .boton--linea:hover { background: var(--c-tinta); color: var(--c-papel); }

  .evento__cuerpo { padding: 0.5rem 0 2rem; font-size: 1.02rem; }

  /* Compartir */
  .compartir { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; padding-bottom: 3rem; border-bottom: 1px solid var(--c-borde); margin-bottom: 1rem; }
  .compartir__et { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-tenue); }
  .compartir__botones { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .compartir__b { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--sans); font-size: 0.82rem; color: var(--c-tinta-suave); background: var(--c-crema); border: 1px solid var(--c-borde); padding: 0.5rem 0.95rem; border-radius: 2px; cursor: pointer; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease; }
  .compartir__b:hover { background: var(--c-tinta); color: var(--c-papel); border-color: var(--c-tinta); }
  .compartir__ico { width: 15px; height: 15px; flex-shrink: 0; display: block; }
  .compartir__copiar--ok { background: var(--c-verde); color: var(--c-papel); border-color: var(--c-verde); }

  .mas { margin-top: 4rem; padding-bottom: 3rem; }
  .seccion-cab { display: flex; align-items: baseline; gap: 1.5rem; margin-bottom: 2rem; }
  .seccion-cab h2 { font-size: 1.8rem; }
  .seccion-cab .linea { flex: 1; height: 1px; background: var(--c-borde); }
  .meta { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-tenue); display: block; }
  .rejilla { display: grid; grid-template-columns: repeat(auto-fill, 150px); gap: 1.8rem 1.3rem; justify-content: start; }
  .tarjeta__img { overflow: hidden; border-radius: 3px; border: 1px solid var(--c-borde); aspect-ratio: 3/4; margin-bottom: 0.7rem; background: var(--c-crema); }
  .tarjeta__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .tarjeta:hover .tarjeta__img img { transform: scale(1.04); }
  .tarjeta__img--vacia { display: flex; align-items: center; justify-content: center; }
  .tarjeta__img--vacia span { font-family: var(--serif); font-size: 1.5rem; color: var(--c-borde); letter-spacing: 0.1em; }
  .tarjeta__titulo { font-size: 1rem; line-height: 1.25; margin: 0.3rem 0 0; transition: color 0.2s ease; }
  .tarjeta:hover .tarjeta__titulo { color: var(--c-rojo); }

  /* Lightbox del cartel */
  .lightbox {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(20, 18, 15, 0.92);
    display: flex; align-items: center; justify-content: center;
    padding: 2rem;
    opacity: 0; visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    cursor: zoom-out;
  }
  .lightbox--abierto { opacity: 1; visibility: visible; }
  .lightbox img { max-width: 100%; max-height: 100%; height: auto; width: auto; display: block; box-shadow: 0 8px 32px rgba(0,0,0,0.5); }
  .lightbox__cerrar {
    position: absolute; top: 1rem; right: 1.5rem;
    width: 2.5rem; height: 2.5rem; background: none; border: none;
    color: var(--c-papel); font-size: 2rem; line-height: 1; cursor: pointer;
    font-family: var(--sans);
  }
  .lightbox__cerrar:hover { color: var(--c-ocre); }

  @media (max-width: 860px) {
    .evento__principal { grid-template-columns: 1fr; }
  }
</style>
