---
import Base from "../../layouts/Base.astro";
import { getNoticias, getTodosEventos } from "../../lib/supabase";
import { ArrowRight } from "@lucide/astro";

const noticias = await getNoticias();
const eventos = await getTodosEventos();

// Mezclamos noticias y eventos en un solo feed, normalizando los campos
// que nos hacen falta para renderizar la tarjeta.
const items = [
  ...noticias.map((n) => ({
    tipo: "noticia",
    fecha: n.fecha,
    slug: n.slug,
    titulo: n.titulo,
    entradilla: n.entradilla,
    imagen: n.portada_url,
    url: `/noticias/${n.slug}/`,
  })),
  ...eventos.map((e) => ({
    tipo: "evento",
    fecha: e.fecha_inicio,
    slug: e.slug,
    titulo: e.titulo,
    entradilla: e.descripcion ? e.descripcion.split("\n")[0].replace(/[#*]/g, "").trim().slice(0, 180) : null,
    imagen: e.cartel_url,
    url: `/eventos/${e.slug}/`,
  })),
].sort((a, b) => (a.fecha < b.fecha ? 1 : -1));

const destacada = items[0];
const resto = items.slice(1);

const fecha = (d) =>
  new Date(d).toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
---

<Base title="Al día · Federación Pueblos de Riaza" description="Noticias, eventos y actividades de los pueblos de la Sierra de Ayllón.">
  <header class="aldia-cab contenedor-ancho">
    <h1>Al día</h1>
    <p class="aldia-cab__lede">
      Todo lo que pasa en nuestros pueblos: noticias, eventos, fiestas y
      la vida cultural de la comarca.
    </p>
  </header>

  {destacada && (
    <a class="aldia-dest contenedor-ancho" href={destacada.url}>
      {destacada.imagen && (
        <div class="aldia-dest__img"><img src={destacada.imagen} alt={destacada.titulo} /></div>
      )}
      <div class="aldia-dest__txt">
        <span class={`ojillo ${destacada.tipo === "evento" ? "ojillo--evento" : "ojillo--rojo"}`}>
          {destacada.tipo === "evento" ? "Evento" : "Lo último"}
        </span>
        <time class="meta">{fecha(destacada.fecha)}</time>
        <h2>{destacada.titulo}</h2>
        {destacada.entradilla && <p>{destacada.entradilla}</p>}
        <span class="leer">Leer más <ArrowRight size={15} /></span>
      </div>
    </a>
  )}

  <section class="contenedor-ancho aldia-lista">
    <div class="rejilla">
      {resto.map((it) => (
        <a class="tarjeta" href={it.url}>
          {it.imagen ? (
            <div class="tarjeta__img"><img src={it.imagen} alt={it.titulo} /></div>
          ) : (
            <div class="tarjeta__img tarjeta__img--vacia"><span>FPR</span></div>
          )}
          <span class={`tarjeta__etiqueta tarjeta__etiqueta--${it.tipo}`}>
            {it.tipo === "evento" ? "Evento" : "Noticia"}
          </span>
          <time class="meta">{fecha(it.fecha)}</time>
          <h3 class="tarjeta__titulo">{it.titulo}</h3>
          {it.entradilla && <p class="tarjeta__desc">{it.entradilla}</p>}
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .aldia-cab { padding: 4rem 1.5rem 2.5rem; max-width: 52rem; }
  .aldia-cab h1 { font-size: clamp(2.8rem, 7vw, 5rem); margin: 0.6rem 0 0; }
  .aldia-cab__lede { font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--c-tinta-suave); margin-top: 1.2rem; max-width: 38rem; }
  .aldia-tabs { display: flex; gap: 1.6rem; margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid var(--c-borde); }
  .aldia-tabs a { font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-tenue); padding-bottom: 0.5rem; border-bottom: 2px solid transparent; transition: color 0.2s ease, border-color 0.2s ease; }
  .aldia-tabs a:hover { color: var(--c-tinta); }
  .aldia-tabs--activa { color: var(--c-rojo) !important; border-bottom-color: var(--c-rojo) !important; }
  .ojillo--rojo { color: var(--c-rojo); }
  .ojillo--evento { color: var(--c-ocre); }
  .meta { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-tenue); font-family: var(--sans); }
  .tarjeta { position: relative; }
  .tarjeta__etiqueta { display: inline-block; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; padding: 0.2rem 0.55rem; border-radius: 2px; margin-bottom: 0.5rem; }
  .tarjeta__etiqueta--noticia { background: transparent; color: var(--c-tenue); padding-left: 0; }
  .tarjeta__etiqueta--evento { background: var(--c-ocre); color: var(--c-papel); }
  .aldia-dest { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: center; padding-bottom: 3.5rem; margin-bottom: 3.5rem; border-bottom: 1px solid var(--c-borde); }
  .aldia-dest__img { aspect-ratio: 3/2; overflow: hidden; border-radius: 3px; border: 1px solid var(--c-borde); }
  .aldia-dest__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .aldia-dest:hover .aldia-dest__img img { transform: scale(1.03); }
  .aldia-dest__txt .meta { margin: 0.6rem 0 0.4rem; }
  .aldia-dest__txt h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); }
  .aldia-dest__txt p { color: var(--c-tinta-suave); margin: 0.6rem 0 0.8rem; }
  .leer { color: var(--c-rojo); font-size: 0.9rem; font-weight: 500; display: inline-flex; align-items: center; gap: 0.3rem; }
  .aldia-lista { padding-bottom: 2rem; }
  .rejilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem 2rem; }
  .tarjeta__img { overflow: hidden; border-radius: 3px; border: 1px solid var(--c-borde); aspect-ratio: 3/2; margin-bottom: 1rem; }
  .tarjeta__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .tarjeta:hover .tarjeta__img img { transform: scale(1.04); }
  .tarjeta__img--vacia { background: var(--c-crema); display: flex; align-items: center; justify-content: center; }
  .tarjeta__img--vacia span { font-family: var(--serif); font-size: 1.5rem; color: var(--c-borde); letter-spacing: 0.1em; }
  .tarjeta__titulo { font-size: 1.3rem; margin: 0.4rem 0 0.4rem; transition: color 0.2s ease; }
  .tarjeta:hover .tarjeta__titulo { color: var(--c-rojo); }
  .tarjeta__desc { font-size: 0.92rem; color: var(--c-tinta-suave); line-height: 1.6; }
  @media (max-width: 860px) { .aldia-dest { grid-template-columns: 1fr; } .aldia-dest__img { order: -1; } .rejilla { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .rejilla { grid-template-columns: 1fr; } }
</style>
