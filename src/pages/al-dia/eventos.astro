---
import Base from "../../layouts/Base.astro";
import { getEventos } from "../../lib/supabase";

const eventos = await getEventos();

// Formato de fecha amigable. Si hay fecha_fin distinta, mostramos rango.
function formatear(inicio, fin) {
  const opts = { day: "numeric", month: "long", year: "numeric" };
  const i = new Date(inicio).toLocaleDateString("es-ES", opts);
  if (!fin || fin === inicio) return i;
  const f = new Date(fin).toLocaleDateString("es-ES", opts);
  return `Del ${new Date(inicio).toLocaleDateString("es-ES", { day: "numeric", month: "long" })} al ${f}`;
}
---

<Base title="Agenda · Federación Pueblos de Riaza" description="Eventos, fiestas y convocatorias de los pueblos de la Sierra de Ayllón.">
  <header class="aldia-cab contenedor-ancho">
    <h1>Agenda</h1>
    <p class="aldia-cab__lede">
      Convocatorias, fiestas y citas que vienen en nuestros pueblos.
    </p>
    <nav class="aldia-tabs">
      <a href="/al-dia/">Noticias</a>
      <a href="/al-dia/eventos/" class="aldia-tabs--activa">Eventos</a>
    </nav>
  </header>

  {eventos.length === 0 && (
    <section class="aldia-vacio contenedor">
      <p>De momento no hay eventos en agenda. Vuelve pronto, los pueblos no paran.</p>
    </section>
  )}

  {eventos.length > 0 && (
    <section class="contenedor-ancho aldia-lista">
      <div class="rejilla">
        {eventos.map((e) => (
          <a class="tarjeta tarjeta--evento" href={`/eventos/${e.slug}/`}>
            {e.cartel_url ? (
              <div class="tarjeta__img"><img src={e.cartel_url} alt={e.titulo} /></div>
            ) : (
              <div class="tarjeta__img tarjeta__img--vacia"><span>FPR</span></div>
            )}
            <time class="meta">{formatear(e.fecha_inicio, e.fecha_fin)}</time>
            <h3 class="tarjeta__titulo">{e.titulo}</h3>
            {e.lugar && <p class="tarjeta__lugar">{e.lugar}</p>}
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .aldia-cab { padding: 4rem 1.5rem 2.5rem; max-width: 52rem; }
  .aldia-cab h1 { font-size: clamp(2.8rem, 7vw, 5rem); margin: 0.6rem 0 0; }
  .aldia-cab__lede { font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--c-tinta-suave); margin-top: 1.2rem; max-width: 38rem; }
  .aldia-tabs { display: flex; gap: 1.6rem; margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid var(--c-borde); }
  .aldia-tabs a { font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-tenue); padding-bottom: 0.5rem; border-bottom: 2px solid transparent; transition: color 0.2s ease, border-color 0.2s ease; }
  .aldia-tabs a:hover { color: var(--c-tinta); }
  .aldia-tabs--activa { color: var(--c-rojo) !important; border-bottom-color: var(--c-rojo) !important; }

  .aldia-vacio { padding: 3rem 1.5rem 5rem; max-width: 40rem; }
  .aldia-vacio p { font-family: var(--serif); font-style: italic; font-size: 1.2rem; color: var(--c-tinta-suave); }

  .aldia-lista { padding-bottom: 3rem; }
  .rejilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem 2rem; }
  .tarjeta__img { overflow: hidden; border-radius: 2px; aspect-ratio: 3/4; margin-bottom: 1rem; background: var(--c-crema); display: flex; align-items: center; justify-content: center; }
  .tarjeta__img img { width: 100%; height: 100%; object-fit: contain; transition: transform 0.6s ease; }
  .tarjeta:hover .tarjeta__img img { transform: scale(1.04); }
  .tarjeta__img--vacia { display: flex; align-items: center; justify-content: center; }
  .tarjeta__img--vacia span { font-family: var(--serif); font-size: 1.5rem; color: var(--c-borde); letter-spacing: 0.1em; }
  .meta { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-tenue); display: block; }
  .tarjeta__titulo { font-size: 1.3rem; margin: 0.4rem 0 0.4rem; transition: color 0.2s ease; }
  .tarjeta:hover .tarjeta__titulo { color: var(--c-rojo); }
  .tarjeta__lugar { font-size: 0.92rem; color: var(--c-tinta-suave); }
  @media (max-width: 860px) { .rejilla { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .rejilla { grid-template-columns: 1fr; } }
</style>
