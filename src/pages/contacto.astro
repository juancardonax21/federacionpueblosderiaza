---
import Base from "../layouts/Base.astro";
import { MapPin, Mail, Send } from "@lucide/astro";
---

<Base title="Contacto · Federación Pueblos de Riaza" description="Escríbenos: estamos a tu disposición para consultas, prensa y colaboraciones.">
  <section class="contacto contenedor">
    <header class="contacto__cab">
      <p class="ojillo">Contacto</p>
      <h1>Hablemos</h1>
      <p class="contacto__lede">
        ¿Tienes una consulta, una propuesta o quieres saber más sobre la
        Federación? Escríbenos y te responderemos lo antes posible.
      </p>
    </header>

    <div class="contacto__grid">
      <form class="formulario" id="form-contacto">
        <div class="campo">
          <label for="nombre">Nombre</label>
          <input type="text" id="nombre" name="nombre" required />
        </div>
        <div class="campo">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="campo">
          <label for="asunto">Asunto</label>
          <input type="text" id="asunto" name="asunto" />
        </div>
        <div class="campo">
          <label for="mensaje">Mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
        </div>
        <!-- Campo honeypot antispam (oculto a humanos) -->
        <div class="hp" aria-hidden="true">
          <label for="web">No rellenar</label>
          <input type="text" id="web" name="web" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="enviar"><span>Enviar mensaje</span> <Send size={15} /></button>
        <p class="aviso" id="aviso"></p>
      </form>

      <aside class="contacto__datos">
        <div class="dato">
          <h2><span class="dato__ico"><MapPin size={15} /></span> Dónde estamos</h2>
          <p>Plaza de la Constitución, 1<br />40510 Madriguera, Riaza (Segovia)</p>
        </div>
        <div class="dato">
          <h2><span class="dato__ico"><Mail size={15} /></span> Email</h2>
          <p><a href="mailto:info@federacionpueblosderiaza.org">info@federacionpueblosderiaza.org</a></p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById("form-contacto");
  const aviso = document.getElementById("aviso");
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const boton = form.querySelector("button");
    const botonLabel = boton.querySelector("span");
    boton.disabled = true;
    botonLabel.textContent = "Enviando...";
    aviso.textContent = "";
    aviso.className = "aviso";

    const datos = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch("/api/contacto", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(datos),
      });
      const json = await res.json();
      if (json.ok) {
        form.reset();
        aviso.innerHTML = "✓ &nbsp;¡Gracias! Hemos recibido tu mensaje y te responderemos pronto.";
        aviso.classList.add("aviso--ok");
        aviso.scrollIntoView({ behavior: "smooth", block: "center" });
      } else {
        aviso.textContent = json.error || "No se pudo enviar. Inténtalo de nuevo.";
        aviso.classList.add("aviso--error");
      }
    } catch {
      aviso.textContent = "No se pudo enviar. Revisa tu conexión e inténtalo de nuevo.";
      aviso.classList.add("aviso--error");
    } finally {
      boton.disabled = false;
      botonLabel.textContent = "Enviar mensaje";
    }
  });
</script>

<style>
  .contacto { padding: 4rem 0 5rem; }
  .contacto__cab { max-width: 40rem; margin-bottom: 3rem; }
  .contacto__cab h1 { font-size: clamp(2.6rem, 7vw, 4.5rem); margin: 0.6rem 0 0; }
  .contacto__lede { font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--c-tinta-suave); margin-top: 1.2rem; }

  .contacto__grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 4rem; align-items: start; }

  .formulario { display: flex; flex-direction: column; gap: 1.3rem; }
  .campo { display: flex; flex-direction: column; gap: 0.4rem; }
  .campo label { font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-tenue); font-weight: 500; }
  .campo input, .campo textarea {
    font-family: var(--sans); font-size: 1rem; color: var(--c-tinta);
    background: var(--c-papel); border: 1px solid var(--c-borde);
    border-radius: 2px; padding: 0.75rem 0.9rem; width: 100%;
    transition: border-color 0.2s ease;
  }
  .campo input:focus, .campo textarea:focus { outline: none; border-color: var(--c-rojo); }
  .campo textarea { resize: vertical; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .enviar {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--c-tinta); color: var(--c-papel);
    border: none; padding: 0.85rem 2rem; font-size: 0.85rem; letter-spacing: 0.06em;
    text-transform: uppercase; border-radius: 2px; cursor: pointer; transition: background 0.2s ease;
    font-family: var(--sans); margin-top: 0.5rem;
  }
  .enviar:hover { background: var(--c-rojo); }
  .enviar:disabled { opacity: 0.6; cursor: default; }

  .aviso { font-size: 1rem; margin: 0.5rem 0 0; }
  .aviso:empty { display: none; }
  .aviso--ok {
    background: color-mix(in srgb, var(--c-verde) 12%, var(--c-papel));
    border: 1px solid color-mix(in srgb, var(--c-verde) 35%, transparent);
    border-left: 4px solid var(--c-verde);
    color: var(--c-verde); padding: 1rem 1.2rem; border-radius: 3px;
    font-weight: 500; line-height: 1.4;
  }
  .aviso--error {
    background: color-mix(in srgb, var(--c-rojo) 10%, var(--c-papel));
    border: 1px solid color-mix(in srgb, var(--c-rojo) 35%, transparent);
    border-left: 4px solid var(--c-rojo);
    color: var(--c-rojo); padding: 1rem 1.2rem; border-radius: 3px;
    font-weight: 500; line-height: 1.4;
  }

  .contacto__datos { display: flex; flex-direction: column; gap: 2rem; padding-top: 0.5rem; }
  .dato h2 { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-tenue); margin-bottom: 0.5rem; }
  .dato__ico { color: var(--c-rojo); display: inline-flex; }
  .dato p { color: var(--c-tinta-suave); line-height: 1.6; }
  .dato a { color: var(--c-rojo); }
  .dato a:hover { text-decoration: underline; }

  @media (max-width: 760px) {
    .contacto__grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
