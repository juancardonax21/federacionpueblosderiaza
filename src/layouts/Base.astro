---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { MapPin, Mail, ShieldCheck } from "@lucide/astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description, image } = Astro.props;

const SITIO = "https://federacionpueblosderiaza.org";
const descripcionDefecto = "La voz común de los pueblos de la Sierra de Ayllón.";
const ogDescripcion = description || descripcionDefecto;
// Imagen para compartir: la que se pase, o una por defecto. Soporta tanto
// rutas internas (/images/..) como URLs completas (https://..).
const imagenBase = image || "/images/Esplendor-en-las-praderas-de-El-Muyo.jpg";
const ogImagen = imagenBase.startsWith("http") ? imagenBase : SITIO + imagenBase;
const ogUrl = SITIO + Astro.url.pathname;

const nav = [
  { href: "/la-federacion/", label: "La Federación" },
  { href: "/el-territorio/", label: "El Territorio" },
  { href: "/patrimonio/", label: "Patrimonio" },
  { href: "/los-pueblos/", label: "Los Pueblos" },
  { href: "/al-dia/", label: "Al día" },
  { href: "/contacto/", label: "Contacto" },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- Open Graph (vista previa al compartir) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescripcion} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="Federación de Pueblos de Riaza" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescripcion} />
    <meta name="twitter:image" content={ogImagen} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>
  <body>
    <header class="sitio-header">
      <div class="contenedor-ancho sitio-header__inner">
        <a href="/" class="marca">
          <Logo variante="completo" />
        </a>
        <nav class="sitio-nav">
          {nav.map((i) => <a href={i.href}>{i.label}</a>)}
        </nav>
        <button class="hamburguesa" id="abrir-menu" aria-label="Abrir menú" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <div class="menu-movil" id="menu-movil" aria-hidden="true">
      <button class="menu-movil__cerrar" id="cerrar-menu" aria-label="Cerrar menú">
        <span></span><span></span>
      </button>
      <nav class="menu-movil__nav">
        {nav.map((i) => <a href={i.href}>{i.label}</a>)}
      </nav>
    </div>

    <main>
      <slot />
    </main>

    <footer class="sitio-footer">
      <div class="contenedor-ancho">
        <div class="sitio-footer__grid">
          <div>
            <div class="sitio-footer__marca"><Logo variante="completo" /></div>
            <p style="color: var(--c-tinta-suave); font-size: 0.95rem; max-width: 24rem; margin-top: 1.4rem;">
              La voz de nuestras asociaciones en la búsqueda de soluciones y
              mejoras para la comarca.
            </p>
            <p class="sitio-footer__codinse">
              Miembro de <a href="https://www.codinse.com" target="_blank" rel="noopener">CODINSE</a>,
              Coordinadora para el Desarrollo Integral del Nordeste de Segovia.
            </p>
          </div>
          <div>
            <h4>Acerca de</h4>
            <ul>
              <li><a href="/la-federacion/">La Federación</a></li>
              <li><a href="/el-territorio/">El Territorio</a></li>
              <li><a href="/patrimonio/">Patrimonio</a></li>
              <li><a href="/los-pueblos/">Los Pueblos</a></li>
              <li><a href="/al-dia/">Al día</a></li>
              <li><a href="/contacto/">Contacto</a></li>
            </ul>
          </div>
          <div>
            <h4>Dónde estamos</h4>
            <p style="color: var(--c-tinta-suave); font-size: 0.95rem; display: flex; gap: 0.55rem; align-items: flex-start;">
              <MapPin size={16} style="color: var(--c-rojo); flex-shrink: 0; margin-top: 0.2rem;" />
              <span>Plaza de la Constitución, 1<br />40510 Madriguera, Riaza (Segovia)</span>
            </p>
            <p style="font-size: 0.95rem; display: flex; gap: 0.55rem; align-items: center; margin-top: 0.7rem;">
              <Mail size={16} style="color: var(--c-rojo); flex-shrink: 0;" />
              <a href="mailto:info@federacionpueblosderiaza.org">info@federacionpueblosderiaza.org</a>
            </p>
          </div>
        </div>
        <p class="sitio-footer__cookies">
          <ShieldCheck size={15} style="color: var(--c-verde); flex-shrink: 0;" />
          Web sin cookies · analítica anónima, respetamos tu privacidad
        </p>
        <div class="sitio-footer__legal">
          © {year} Federación de Pueblos de Riaza ·
          <a href="/politica-de-privacidad/">Política de privacidad</a> ·
          <a href="/politica-privacidad/">Términos</a>
        </div>
      </div>
    </footer>
    <Analytics />
    <script>
      const abrir = document.getElementById("abrir-menu");
      const cerrar = document.getElementById("cerrar-menu");
      const menu = document.getElementById("menu-movil");

      function abrirMenu() {
        menu.classList.add("menu-movil--abierto");
        menu.setAttribute("aria-hidden", "false");
        abrir.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      }
      function cerrarMenu() {
        menu.classList.remove("menu-movil--abierto");
        menu.setAttribute("aria-hidden", "true");
        abrir.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      }

      abrir?.addEventListener("click", abrirMenu);
      cerrar?.addEventListener("click", cerrarMenu);
      // Cerrar al pulsar cualquier enlace del menú
      menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", cerrarMenu));
      // Cerrar con tecla Escape
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") cerrarMenu(); });
    </script>
  </body>
</html>
