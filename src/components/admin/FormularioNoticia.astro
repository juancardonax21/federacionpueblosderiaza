---
interface Props {
  noticia?: any;
}
const { noticia = null } = Astro.props;
const esEdicion = !!noticia;
---

<form id="form-noticia" class="fe" data-noticia-id={noticia?.id || ""}>
  <fieldset class="fe-seccion">
    <legend class="fe-legend">Información básica</legend>

    <div class="fe-campo">
      <label for="titulo">Título *</label>
      <input type="text" id="titulo" name="titulo" required
             value={noticia?.titulo || ""} placeholder="Titular de la noticia" />
    </div>

    <div class="fe-campo">
      <label for="slug">
        Slug (URL)
        <button type="button" id="regen-slug" class="fe-mini-btn" title="Regenerar desde el título">↺</button>
      </label>
      <div class="fe-slug-wrap">
        <span class="fe-slug-prefix">/noticias/</span>
        <input type="text" id="slug" name="slug" required
               value={noticia?.slug || ""} placeholder="url-de-la-noticia" />
        <span class="fe-slug-suffix">/</span>
      </div>
      <p class="fe-ayuda">Se rellena solo al escribir el título. Puedes editarlo.</p>
    </div>

    <div class="fe-campo">
      <label for="entradilla">Entradilla</label>
      <textarea id="entradilla" name="entradilla" rows="2"
                placeholder="Una o dos frases que resumen la noticia.">{noticia?.entradilla || ""}</textarea>
      <p class="fe-ayuda">Aparece bajo el titular y en las tarjetas del listado.</p>
    </div>

    <div class="fe-campo">
      <label for="contenido">Contenido (admite Markdown)</label>
      <div class="fe-md-barra">
        <button type="button" class="fe-md-btn" data-md="bold" title="Negrita (Cmd+B)"><strong>B</strong></button>
        <button type="button" class="fe-md-btn" data-md="italic" title="Cursiva (Cmd+I)"><em>i</em></button>
        <span class="fe-md-sep"></span>
        <button type="button" class="fe-md-btn" data-md="h2" title="Título">H2</button>
        <button type="button" class="fe-md-btn" data-md="h3" title="Subtítulo">H3</button>
        <span class="fe-md-sep"></span>
        <button type="button" class="fe-md-btn" data-md="ul" title="Lista">• Lista</button>
        <button type="button" class="fe-md-btn" data-md="quote" title="Cita">❝</button>
        <span class="fe-md-sep"></span>
        <button type="button" class="fe-md-btn" data-md="link" title="Enlace (Cmd+K)">🔗</button>
        <button type="button" class="fe-md-btn" data-md="hr" title="Separador">―</button>
      </div>
      <textarea id="contenido" name="contenido"
                placeholder="Escribe aquí. Selecciona texto y pulsa un botón para darle formato.">{noticia?.contenido || ""}</textarea>
      <p class="fe-ayuda">La barra de arriba te ayuda a dar formato.</p>
    </div>
  </fieldset>

  <fieldset class="fe-seccion">
    <legend class="fe-legend">Fecha y portada</legend>

    <div class="fe-fila">
      <div class="fe-campo">
        <label for="fecha">Fecha *</label>
        <input type="date" id="fecha" name="fecha" required
               value={noticia?.fecha || ""} />
      </div>
      <div></div>
    </div>

    <div class="fe-campo">
      <label>Portada</label>
      <div id="portada-preview" class="fe-cartel-preview">
        {noticia?.portada_url ? (
          <img src={noticia.portada_url} alt="Portada actual" />
        ) : (
          <div class="fe-cartel-vacio">Sin portada</div>
        )}
      </div>
      <input type="file" id="portada-file" accept="image/*" />
      <input type="hidden" id="portada_url" name="portada_url" value={noticia?.portada_url || ""} />
      <p class="fe-ayuda">JPG o PNG. Al seleccionar un archivo, se subirá automáticamente.</p>
      <p id="portada-estado" class="fe-cartel-estado" hidden></p>
    </div>
  </fieldset>

  <fieldset class="fe-seccion">
    <legend class="fe-legend">Publicación</legend>

    <div class="fe-check-fila">
      <label class="fe-check">
        <input type="checkbox" id="publicada" name="publicada" checked={noticia?.publicada ?? true} />
        <span>Publicada (visible en la web)</span>
      </label>

      <label class="fe-check">
        <input type="checkbox" id="destacada" name="destacada" checked={noticia?.destacada || false} />
        <span>Destacada</span>
      </label>
    </div>

    <div class="fe-campo">
      <label>Pueblos vinculados</label>
      <div id="pueblos-lista" class="fe-pueblos">
        <p class="fe-ayuda">Cargando pueblos...</p>
      </div>
    </div>
  </fieldset>

  <div class="fe-acciones">
    <a href="/admin/noticias/" class="fe-btn fe-btn-secundario">Cancelar</a>
    <button type="submit" id="btn-guardar" class="fe-btn fe-btn-principal">
      {esEdicion ? "Guardar cambios" : "Crear noticia"}
    </button>
  </div>

  <p id="form-mensaje" class="fe-mensaje" hidden></p>
</form>

<script>
  import { createClient } from "@supabase/supabase-js";

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY
  );

  const { data: sess } = await supabase.auth.getSession();
  if (!sess?.session) window.location.href = "/admin/login/";

  const form = document.getElementById("form-noticia");
  const noticiaId = form.dataset.noticiaId || null;
  const esEdicion = !!noticiaId;

  const inputTitulo = document.getElementById("titulo");
  const inputSlug = document.getElementById("slug");
  const btnRegen = document.getElementById("regen-slug");
  let slugTocado = esEdicion;

  function slugificar(texto) {
    return texto
      .toLowerCase()
      .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9\s-]/g, "")
      .trim()
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-");
  }

  inputTitulo.addEventListener("input", () => {
    if (!slugTocado) inputSlug.value = slugificar(inputTitulo.value);
  });
  inputSlug.addEventListener("input", () => { slugTocado = true; });
  btnRegen.addEventListener("click", () => {
    inputSlug.value = slugificar(inputTitulo.value);
    slugTocado = true;
  });

  const textareaCont = document.getElementById("contenido");

  function envolverSeleccion(inicio, fin = inicio, placeholder = "") {
    const s = textareaCont.selectionStart;
    const e = textareaCont.selectionEnd;
    const texto = textareaCont.value;
    const seleccionado = texto.substring(s, e) || placeholder;
    const nuevo = texto.substring(0, s) + inicio + seleccionado + fin + texto.substring(e);
    textareaCont.value = nuevo;
    textareaCont.focus();
    const posCursor = seleccionado === placeholder
      ? s + inicio.length
      : s + inicio.length + seleccionado.length + fin.length;
    textareaCont.setSelectionRange(posCursor, posCursor + (seleccionado === placeholder ? placeholder.length : 0));
  }

  function prefijarLineas(prefijo, placeholder = "") {
    const s = textareaCont.selectionStart;
    const e = textareaCont.selectionEnd;
    const texto = textareaCont.value;
    let inicioLinea = s;
    while (inicioLinea > 0 && texto[inicioLinea - 1] !== "\n") inicioLinea--;
    const seleccionado = texto.substring(inicioLinea, e) || placeholder;
    const conPrefijo = seleccionado.split("\n").map((l) => (l ? prefijo + l : l)).join("\n");
    textareaCont.value = texto.substring(0, inicioLinea) + conPrefijo + texto.substring(e);
    textareaCont.focus();
    const posCursor = inicioLinea + conPrefijo.length;
    textareaCont.setSelectionRange(posCursor, posCursor);
  }

  function insertarEnCursor(fragmento) {
    const s = textareaCont.selectionStart;
    const texto = textareaCont.value;
    const antes = texto.substring(0, s);
    const despues = texto.substring(s);
    const separador = antes && !antes.endsWith("\n") ? "\n\n" : "";
    const separadorDespues = despues && !despues.startsWith("\n") ? "\n\n" : "";
    textareaCont.value = antes + separador + fragmento + separadorDespues + despues;
    textareaCont.focus();
    const posCursor = s + separador.length + fragmento.length;
    textareaCont.setSelectionRange(posCursor, posCursor);
  }

  document.querySelectorAll(".fe-md-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const md = btn.dataset.md;
      if (md === "bold") envolverSeleccion("**", "**", "texto en negrita");
      else if (md === "italic") envolverSeleccion("*", "*", "texto en cursiva");
      else if (md === "h2") prefijarLineas("## ", "Título");
      else if (md === "h3") prefijarLineas("### ", "Subtítulo");
      else if (md === "ul") prefijarLineas("- ", "Elemento de la lista");
      else if (md === "quote") prefijarLineas("> ", "Cita");
      else if (md === "link") envolverSeleccion("[", "](https://)", "texto del enlace");
      else if (md === "hr") insertarEnCursor("---");
    });
  });

  textareaCont.addEventListener("keydown", (ev) => {
    if ((ev.metaKey || ev.ctrlKey) && ev.key === "b") { ev.preventDefault(); envolverSeleccion("**", "**", "texto en negrita"); }
    else if ((ev.metaKey || ev.ctrlKey) && ev.key === "i") { ev.preventDefault(); envolverSeleccion("*", "*", "texto en cursiva"); }
    else if ((ev.metaKey || ev.ctrlKey) && ev.key === "k") { ev.preventDefault(); envolverSeleccion("[", "](https://)", "texto del enlace"); }
  });

  const inputFile = document.getElementById("portada-file");
  const inputPortadaUrl = document.getElementById("portada_url");
  const preview = document.getElementById("portada-preview");
  const estadoSubida = document.getElementById("portada-estado");

  inputFile.addEventListener("change", async () => {
    const file = inputFile.files[0];
    if (!file) return;
    estadoSubida.hidden = false;
    estadoSubida.textContent = "Subiendo...";
    estadoSubida.className = "fe-cartel-estado";

    const ext = file.name.split(".").pop();
    const nombre = `noticias/${Date.now()}-${slugificar(file.name.replace(/\.[^.]+$/, ""))}.${ext}`;
    const { data, error } = await supabase.storage
      .from("imagenes")
      .upload(nombre, file, { cacheControl: "3600", upsert: false });

    if (error) {
      estadoSubida.textContent = "Error al subir: " + error.message;
      estadoSubida.className = "fe-cartel-estado fe-cartel-estado-error";
      return;
    }

    const { data: urlData } = supabase.storage.from("imagenes").getPublicUrl(data.path);
    inputPortadaUrl.value = urlData.publicUrl;
    preview.innerHTML = `<img src="${urlData.publicUrl}" alt="Portada subida" />`;
    estadoSubida.textContent = "✓ Portada subida correctamente.";
    estadoSubida.className = "fe-cartel-estado fe-cartel-estado-ok";
  });

  const listaPueblos = document.getElementById("pueblos-lista");
  const { data: pueblos } = await supabase.from("pueblos").select("id, slug, nombre").order("nombre");
  let pueblosVinculados = new Set();

  if (esEdicion) {
    const { data: rels } = await supabase.from("noticias_pueblos").select("pueblo_id").eq("noticia_id", noticiaId);
    pueblosVinculados = new Set((rels || []).map((r) => r.pueblo_id));
  }

  listaPueblos.innerHTML = pueblos.map((p) => `
    <label class="fe-pueblo">
      <input type="checkbox" name="pueblos" value="${p.id}" ${pueblosVinculados.has(p.id) ? "checked" : ""} />
      <span>${p.nombre}</span>
    </label>
  `).join("");

  const mensaje = document.getElementById("form-mensaje");

  form.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    mensaje.hidden = true;

    const datos = {
      titulo: inputTitulo.value.trim(),
      slug: inputSlug.value.trim(),
      entradilla: document.getElementById("entradilla").value.trim() || null,
      contenido: document.getElementById("contenido").value.trim() || null,
      fecha: document.getElementById("fecha").value,
      portada_url: inputPortadaUrl.value || null,
      publicada: document.getElementById("publicada").checked,
      destacada: document.getElementById("destacada").checked,
    };

    if (datos.destacada) {
      await supabase.from("noticias").update({ destacada: false }).eq("destacada", true);
    }

    let idFinal;
    if (esEdicion) {
      const { error } = await supabase.from("noticias").update(datos).eq("id", noticiaId);
      if (error) return mostrarError(error.message);
      idFinal = noticiaId;
    } else {
      const { data, error } = await supabase.from("noticias").insert(datos).select("id").single();
      if (error) return mostrarError(error.message);
      idFinal = data.id;
    }

    await supabase.from("noticias_pueblos").delete().eq("noticia_id", idFinal);
    const seleccionados = [...document.querySelectorAll('input[name="pueblos"]:checked')].map((cb) => cb.value);
    if (seleccionados.length > 0) {
      const relaciones = seleccionados.map((puebloId) => ({ noticia_id: idFinal, pueblo_id: puebloId }));
      await supabase.from("noticias_pueblos").insert(relaciones);
    }

    mensaje.textContent = esEdicion ? "✓ Cambios guardados." : "✓ Noticia creada.";
    mensaje.className = "fe-mensaje fe-mensaje-ok";
    mensaje.hidden = false;
    setTimeout(() => { window.location.href = "/admin/noticias/"; }, 1200);
  });

  function mostrarError(msg) {
    mensaje.textContent = "Error: " + msg;
    mensaje.className = "fe-mensaje fe-mensaje-error";
    mensaje.hidden = false;
  }

  document.getElementById("entradilla").style.minHeight = "5rem";
</script>

<style is:global>
  .fe { max-width: 48rem; }
  .fe-seccion { border: 1px solid var(--c-borde); border-radius: 2px; padding: 1.5rem; margin-bottom: 1.5rem; background: var(--c-papel); }
  .fe-legend { font-family: var(--sans); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-rojo); padding: 0 0.5rem; font-weight: 500; }

  .fe-campo { margin-bottom: 1.2rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .fe-campo:last-child { margin-bottom: 0; }
  .fe-campo label { font-size: 0.85rem; font-weight: 500; color: var(--c-tinta); display: flex; align-items: center; gap: 0.5rem; }
  .fe-campo input[type="text"],
  .fe-campo input[type="url"],
  .fe-campo input[type="date"],
  .fe-campo textarea { padding: 0.6rem 0.8rem; border: 1px solid var(--c-borde); border-radius: 2px; font-family: var(--sans); font-size: 0.95rem; background: var(--c-papel); color: var(--c-tinta); }
  .fe-campo input:focus, .fe-campo textarea:focus { outline: none; border-color: var(--c-rojo); }
  .fe-ayuda { font-size: 0.78rem; color: var(--c-tenue); margin: 0; }

  #contenido {
    min-height: 28rem !important;
    padding: 1.2rem !important;
    font-size: 0.9rem !important;
    background: var(--c-papel) !important;
    border: 1px solid var(--c-borde) !important;
    font-family: monospace !important;
    line-height: 1.6 !important;
  }
  #contenido:focus {
    border-color: var(--c-rojo) !important;
    box-shadow: 0 0 0 3px rgba(160, 48, 16, 0.1) !important;
  }

  .fe-fila { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  @media (max-width: 640px) { .fe-fila { grid-template-columns: 1fr; } }

  .fe-slug-wrap { display: flex; align-items: center; border: 1px solid var(--c-borde); border-radius: 2px; overflow: hidden; }
  .fe-slug-wrap:focus-within { border-color: var(--c-rojo); }
  .fe-slug-prefix, .fe-slug-suffix { background: var(--c-crema); color: var(--c-tenue); padding: 0.6rem 0.6rem; font-size: 0.85rem; font-family: monospace; }
  .fe-slug-wrap input { border: none !important; flex: 1; padding: 0.6rem !important; font-family: monospace !important; }
  .fe-slug-wrap input:focus { outline: none; }

  .fe-mini-btn { background: none; border: 1px solid var(--c-borde); padding: 0.15rem 0.4rem; font-size: 0.75rem; cursor: pointer; border-radius: 2px; color: var(--c-tinta-suave); }
  .fe-mini-btn:hover { color: var(--c-rojo); border-color: var(--c-rojo); }

  .fe-cartel-preview { width: 12rem; margin-bottom: 0.8rem; }
  .fe-cartel-preview img { width: 100%; height: auto; border: 1px solid var(--c-borde); border-radius: 2px; display: block; }
  .fe-cartel-vacio { aspect-ratio: 3/4; background: var(--c-crema); border: 1px dashed var(--c-borde); display: flex; align-items: center; justify-content: center; color: var(--c-tenue); font-size: 0.85rem; }
  .fe-cartel-estado { font-size: 0.85rem; margin: 0.5rem 0 0; }
  .fe-cartel-estado-ok { color: var(--c-verde); }
  .fe-cartel-estado-error { color: var(--c-rojo); }

  .fe-check-fila { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.2rem; }
  .fe-check { display: flex; align-items: center; gap: 0.6rem; cursor: pointer; }
  .fe-check input { width: 1.1rem; height: 1.1rem; cursor: pointer; }
  .fe-check span { font-size: 0.9rem; }

  .fe-pueblos { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0.5rem 1rem; padding: 0.5rem 0; }
  .fe-pueblo { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.88rem; }
  .fe-pueblo input { width: 1rem; height: 1rem; cursor: pointer; }

  .fe-acciones { display: flex; gap: 0.8rem; justify-content: flex-end; padding-top: 1rem; border-top: 1px solid var(--c-borde); }
  .fe-btn { display: inline-block; padding: 0.7rem 1.4rem; font-size: 0.9rem; letter-spacing: 0.03em; border-radius: 2px; border: none; cursor: pointer; font-family: var(--sans); text-decoration: none; transition: background 0.15s ease, color 0.15s ease; }
  .fe-btn-principal { background: var(--c-rojo); color: var(--c-papel); font-weight: 500; }
  .fe-btn-principal:hover { background: var(--c-rojo-hondo); }
  .fe-btn-secundario { background: none; color: var(--c-tinta-suave); border: 1px solid var(--c-borde); }
  .fe-btn-secundario:hover { color: var(--c-tinta); border-color: var(--c-tinta); }

  .fe-mensaje { padding: 0.8rem 1rem; border-radius: 2px; font-size: 0.9rem; margin-top: 1rem; }
  .fe-mensaje-ok { background: var(--c-verde); color: var(--c-papel); }
  .fe-mensaje-error { background: var(--c-rojo); color: var(--c-papel); }

  .fe-md-barra { display: flex; align-items: center; gap: 0.2rem; padding: 0.6rem; background: var(--c-crema); border: 1px solid var(--c-borde); border-bottom: none; border-radius: 3px 3px 0 0; flex-wrap: wrap; }
  .fe-md-btn { background: none; border: 1px solid transparent; padding: 0.4rem 0.7rem; font-size: 0.82rem; cursor: pointer; border-radius: 2px; color: var(--c-tinta-suave); font-family: var(--sans); min-width: auto; }
  .fe-md-btn:hover { background: var(--c-papel); border-color: var(--c-borde); color: var(--c-tinta); }
  .fe-md-sep { width: 1px; height: 1.4rem; background: var(--c-borde); margin: 0 0.4rem; }
  .fe-md-barra + textarea { border-top: none; border-radius: 0 0 3px 3px; }
</style>
